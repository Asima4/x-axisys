---
// Scroll-driven sequence: the ground-floor plan rises into structure, services and architecture.
import Icon from './Icon.astro';

const steps = [
  { code: '01', title: 'Plan', text: 'The actual Axisys floor plan for this Florida home — every room, wall and opening.' },
  { code: '02', title: 'Framing', text: 'Wall framing rises straight off the plan, stud by stud, following every wall on the drawing.' },
  { code: '03', title: 'Walls & openings', text: 'Walls close in around windows, lanai sliders, the front door and two garage doors.' },
  { code: '04', title: 'Roof & render', text: 'The 7:12 hip roof from the roof plan caps the house — then the finished render shows the result.' },
];
const project = { title: 'Single-Family Residence', place: 'Florida', href: '/projects/single-family-residence-florida/' };
---

<section class="build dark" data-build aria-label="From plan to building">
  <div class="build__sticky">
    <div class="build__stage" data-build-stage>
      <img class="build__render" src="/textures/shamita-render.jpg" alt="" loading="lazy" decoding="async" data-build-render />
    </div>
    <div class="build__shade" aria-hidden="true"></div>

    <div class="container build__ui">
      <div class="build__copy">
        <p class="eyebrow">From plan to building</p>
        <h2>One drawing set. One building.</h2>
        <p class="build__project mono">Project · {project.title} · {project.place}</p>
        <ol class="build__steps">
          {
            steps.map((s, i) => (
              <li class:list={{ 'is-active': i === 0 }} data-build-step={i}>
                <span class="build__code mono">{s.code}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a class="text-link" href={project.href}>View the project drawings <Icon name="ArrowRight" /></a>
      </div>
      <div class="build__progress" aria-hidden="true"><span data-build-bar></span></div>
      <p class="build__hint mono" aria-hidden="true" data-build-hint>Scroll to build ↓</p>
    </div>
  </div>
</section>

<style>
  .build {
    position: relative;
    height: 360vh;
    background: var(--steel);
  }

  .build__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .build__stage {
    position: absolute;
    inset: 0;
  }

  @media (min-width: 1000px) {
    .build__stage {
      left: 30%;
    }
  }

  @media (max-width: 999px) {
    .build__stage {
      top: 64px;
      bottom: 44%;
    }
  }

  .build__render {
    position: absolute;
    left: 13%;
    right: 3%;
    top: 50%;
    z-index: 1;
    width: 84%;
    height: auto;
    aspect-ratio: 16 / 9;
    margin-top: calc(-84% * 9 / 32);
    object-fit: cover;
    border-radius: 4px;
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55);
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 0.2s linear;
    pointer-events: none;
  }

  @media (max-width: 999px) {
    .build__render {
      left: 3%;
      width: 94%;
      margin-top: calc(-94% * 9 / 32);
    }
  }

  .build__stage :global(.viewer3d__canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  .build__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, var(--steel) 0%, rgba(13, 15, 19, 0.85) 26%, rgba(13, 15, 19, 0) 48%);
  }

  @media (max-width: 999px) {
    .build__shade {
      background: linear-gradient(180deg, rgba(13, 15, 19, 0) 50%, rgba(13, 15, 19, 0.9) 60%, var(--steel) 100%);
    }
  }

  .build__ui {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  @media (max-width: 999px) {
    .build__ui {
      align-items: flex-end;
      padding-bottom: 36px;
    }
  }

  .build__copy {
    display: grid;
    gap: 20px;
    max-width: 420px;
    pointer-events: auto;
  }

  .build__copy h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
  }

  .build__project {
    margin-top: -8px;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-on-dark);
  }

  .build__steps {
    list-style: none;
    margin: 8px 0 4px;
    padding: 0;
    display: grid;
    gap: 4px;
    border-left: 1px solid var(--line-dark);
  }

  .build__steps li {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 8px;
    padding: 10px 0 10px 18px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    opacity: 0.4;
    transition: opacity 0.35s ease, border-color 0.35s ease;
  }

  .build__steps li.is-active {
    opacity: 1;
    border-left-color: var(--red);
  }

  .build__steps li.is-done {
    opacity: 0.7;
  }

  .build__code {
    font-size: 0.78rem;
    color: var(--blue-on-dark);
    padding-top: 3px;
  }

  .build__steps h3 {
    font-size: 1.1rem;
  }

  .build__steps p {
    font-size: 0.93rem;
    line-height: 1.5;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.4s ease, opacity 0.4s ease, margin 0.4s ease;
  }

  .build__steps li.is-active p {
    max-height: 5em;
    opacity: 1;
    margin-top: 4px;
  }

  @media (max-width: 999px) {
    .build__copy {
      gap: 12px;
    }

    .build__steps li:not(.is-active) {
      display: none;
    }

    .build__steps {
      border-left: 0;
      margin: 0;
    }

    .build__steps li {
      padding-left: 0;
      border-left: 0;
    }
  }

  .build__progress {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    height: 2px;
    background: var(--line-dark);
  }

  .build__progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--blue-on-dark), var(--red));
    transform-origin: left;
    transform: scaleX(0);
  }

  .build__hint {
    position: absolute;
    right: var(--gutter);
    bottom: 20px;
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-2);
    transition: opacity 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .build {
      height: auto;
    }

    .build__sticky {
      position: relative;
      height: 90vh;
    }

    .build__steps li {
      opacity: 1;
    }

    .build__steps p {
      max-height: none;
      opacity: 1;
    }

    .build__hint,
    .build__progress {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-build]').forEach((section) => {
    const stage = section.querySelector<HTMLElement>('[data-build-stage]')!;
    const steps = [...section.querySelectorAll<HTMLElement>('[data-build-step]')];
    const bar = section.querySelector<HTMLElement>('[data-build-bar]')!;
    const hint = section.querySelector<HTMLElement>('[data-build-hint]')!;
    const renderImg = section.querySelector<HTMLElement>('[data-build-render]')!;
    const thresholds = [0, 0.18, 0.42, 0.64];
    let viewer: { setBuild: (p: number) => void } | null = null;

    const progress = () => {
      const r = section.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      return total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      const p = progress();
      viewer?.setBuild(p);
      bar.style.transform = `scaleX(${p})`;
      const r = Math.min(1, Math.max(0, (p - 0.88) / 0.1));
      renderImg.style.opacity = String(r);
      renderImg.style.transform = `scale(${0.96 + 0.04 * r})`;
      hint.style.opacity = p > 0.04 ? '0' : '1';
      let active = 0;
      thresholds.forEach((t, i) => {
        if (p >= t) active = i;
      });
      steps.forEach((s, i) => {
        s.classList.toggle('is-active', i === active);
        s.classList.toggle('is-done', i < active);
      });
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries[0].isIntersecting || viewer) return;
        io.disconnect();
        try {
          const [{ mountHouseBuild }, { default: model }] = await Promise.all([
            import('../scripts/houseBuild'),
            import('../data/shamita-model.json'),
          ]);
          viewer = mountHouseBuild(stage, model as never, '/textures/shamita-plan.webp');
          update();
        } catch (err) {
          console.error(err);
        }
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(section);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  });
</script>
