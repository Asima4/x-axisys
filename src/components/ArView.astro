---
// "View in AR": opens a dialog with <model-viewer> (self-hosted in /public/vendor). On a phone it places the
// model in the room (WebXR / Scene Viewer / Quick Look); on desktop it shows a QR code that opens the same view.
import QRCode from 'qrcode';
import Icon from './Icon.astro';

interface Props {
  id: string;
  src: string;
  title: string;
  scale: string;
  variant?: 'overlay' | 'outline';
}

const { id, src, title, scale, variant = 'outline' } = Astro.props;
const pageUrl = new URL(`${Astro.url.pathname}#ar-${id}`, Astro.site ?? 'https://axisysglobal.com').toString();
const qr = await QRCode.toString(pageUrl, { type: 'svg', margin: 1, color: { dark: '#14161a', light: '#ffffff' } });
---

<button type="button" class:list={['ar-trigger', `ar-trigger--${variant}`]} data-ar-open={id}>
  <Icon name="Smartphone" size={16} />
  <span>View in AR</span>
</button>

<dialog class="ar" data-ar={id} data-ar-src={src} aria-label={`${title} in augmented reality`}>
  <div class="ar__head">
    <div>
      <p class="ar__kicker mono">Augmented reality · {scale}</p>
      <h3>{title}</h3>
    </div>
    <button type="button" class="ar__close" data-ar-close aria-label="Close"><Icon name="X" size={20} /></button>
  </div>
  <div class="ar__body">
    <div class="ar__stage" data-ar-stage>
      <p class="ar__loading mono" data-ar-loading>Loading 3D model…</p>
    </div>
    <aside class="ar__side">
      <div class="ar__phone" data-ar-phone hidden>
        <p class="ar__step"><b>1</b> Tap <strong>Place in your room</strong>.</p>
        <p class="ar__step"><b>2</b> Point the camera at a table or the floor and move it slowly.</p>
        <p class="ar__step"><b>3</b> Tap to place. Pinch to scale, drag to move, twist to rotate.</p>
      </div>
      <div class="ar__desk" data-ar-desk>
        <div class="ar__qr" set:html={qr} />
        <p>Scan with your phone's camera to open this model, then tap <strong>Place in your room</strong> to see it on your table.</p>
        <p class="ar__fine mono">Works on recent iPhone (Safari) and Android (Chrome) phones.</p>
      </div>
    </aside>
  </div>
</dialog>

<style>
  .ar-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .ar-trigger--overlay {
    border: 1px solid var(--line-dark);
    background: rgba(13, 15, 19, 0.82);
    color: var(--on-dark);
    backdrop-filter: blur(6px);
  }

  .ar-trigger--overlay:hover {
    border-color: var(--blue-on-dark);
  }

  .ar-trigger--outline {
    border: 1px solid var(--blue-on-dark);
    background: transparent;
    color: var(--on-dark);
  }

  .ar-trigger--outline:hover {
    background: var(--blue);
    border-color: var(--blue);
  }

  @media (max-width: 640px) {
    .ar-trigger--overlay span {
      display: none;
    }

    .ar-trigger--overlay {
      width: 40px;
      padding: 0;
      justify-content: center;
    }
  }

  .ar {
    width: min(1040px, 96vw);
    max-width: 96vw;
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: var(--steel-2);
    color: var(--on-dark);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
  }

  .ar::backdrop {
    background: rgba(8, 10, 13, 0.75);
    backdrop-filter: blur(3px);
  }

  .ar[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .ar__head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 16px;
    padding: 16px 20px 12px;
    border-bottom: 1px solid var(--line-dark);
  }

  .ar__kicker {
    margin: 0 0 2px;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-on-dark);
  }

  .ar__head h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .ar__close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-dark);
    background: transparent;
    color: var(--on-dark);
    cursor: pointer;
  }

  .ar__body {
    display: grid;
    min-height: 0;
  }

  @media (min-width: 820px) {
    .ar__body {
      grid-template-columns: minmax(0, 1fr) 280px;
    }
  }

  .ar__stage {
    position: relative;
    min-height: 0;
    height: min(62vh, 560px);
    background: radial-gradient(ellipse at 50% 40%, #232833, #0d0f13 70%);
  }

  .ar__stage :global(model-viewer) {
    width: 100%;
    height: 100%;
    --poster-color: transparent;
  }

  .ar__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .ar__stage :global(.ar__place) {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 22px;
    border: 0;
    background: var(--blue);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .ar__side {
    padding: 18px 20px;
    border-top: 1px solid var(--line-dark);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--on-dark-2);
  }

  @media (min-width: 820px) {
    .ar__side {
      border-top: 0;
      border-left: 1px solid var(--line-dark);
    }
  }

  .ar__side strong {
    color: var(--on-dark);
  }

  .ar__step {
    display: flex;
    gap: 10px;
    margin: 0 0 12px;
  }

  .ar__step b {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    background: var(--blue);
    color: #fff;
    font-size: 0.75rem;
  }

  .ar__qr {
    width: 180px;
    margin: 0 0 14px;
    padding: 8px;
    background: #fff;
  }

  .ar__qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .ar__desk p {
    margin: 0 0 10px;
  }

  .ar__fine {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .ar {
      width: 100vw;
      max-width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
    }

    .ar__stage {
      height: 62dvh;
    }
  }
</style>

<script>
  const MV = '/vendor/model-viewer-4.4.0.min.js';
  let loading: Promise<void> | null = null;
  const loadModelViewer = () =>
    (loading ??= new Promise<void>((resolve, reject) => {
      if (customElements.get('model-viewer')) return resolve();
      const s = document.createElement('script');
      s.type = 'module';
      s.src = MV;
      s.onload = () => customElements.whenDefined('model-viewer').then(() => resolve());
      s.onerror = reject;
      document.head.append(s);
    }));

  document.querySelectorAll<HTMLDialogElement>('dialog[data-ar]').forEach((dlg) => {
    const id = dlg.dataset.ar!;
    const stage = dlg.querySelector<HTMLElement>('[data-ar-stage]')!;
    const open = async () => {
      if (!dlg.open) dlg.showModal();
      if (stage.querySelector('model-viewer')) return;
      try {
        await loadModelViewer();
        const mv = document.createElement('model-viewer') as HTMLElement & { canActivateAR?: boolean };
        Object.entries({
          src: dlg.dataset.arSrc!,
          alt: dlg.getAttribute('aria-label') ?? '3D model',
          ar: '',
          'ar-modes': 'webxr scene-viewer quick-look',
          'ar-scale': 'auto',
          'camera-controls': '',
          'auto-rotate': '',
          'touch-action': 'pan-y',
          'shadow-intensity': '1',
          'shadow-softness': '0.8',
          exposure: '0.9',
          'environment-image': 'neutral',
          'camera-orbit': '-35deg 62deg auto',
          'interaction-prompt': 'none',
        }).forEach(([k, v]) => mv.setAttribute(k, v));
        mv.innerHTML = '<button slot="ar-button" class="ar__place" type="button">Place in your room</button>';
        mv.addEventListener('load', () => {
          dlg.querySelector('[data-ar-loading]')?.remove();
          const can = !!mv.canActivateAR;
          dlg.querySelector<HTMLElement>('[data-ar-phone]')!.hidden = !can;
          dlg.querySelector<HTMLElement>('[data-ar-desk]')!.hidden = can;
        });
        stage.append(mv);
      } catch (err) {
        console.error(err);
        dlg.querySelector('[data-ar-loading]')!.textContent = '3D view unavailable on this device';
      }
    };
    document.querySelectorAll<HTMLButtonElement>(`[data-ar-open="${id}"]`).forEach((b) => b.addEventListener('click', open));
    dlg.querySelector('[data-ar-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    if (location.hash === `#ar-${id}`) open();
  });
</script>
