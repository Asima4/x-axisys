---
// Decorative structural elevation drawing for the home hero.
const cols = [
  { x: 110, label: 'A' },
  { x: 240, label: 'B' },
  { x: 370, label: 'C' },
  { x: 500, label: 'D' },
];
const levels = [
  { y: 470, label: '±0.00' },
  { y: 380, label: '+3.60' },
  { y: 290, label: '+7.20' },
  { y: 200, label: '+10.80' },
  { y: 110, label: '+14.40' },
];
const ground = levels[0].y;
const roof = levels[levels.length - 1].y;
const left = cols[0].x;
const right = cols[cols.length - 1].x;
---

<svg class="blueprint" viewBox="0 0 620 580" role="img" aria-labelledby="bp-title">
  <title id="bp-title">Structural elevation drawing of a braced building frame</title>
  <defs>
    <pattern id="bp-minor" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.09"></path>
    </pattern>
    <pattern id="bp-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="8" stroke="#6b7280" stroke-width="1"></line>
    </pattern>
  </defs>

  <rect width="620" height="580" fill="url(#bp-minor)"></rect>

  <!-- Structural gridlines + bubbles -->
  <g class="bp-grid">
    {
      cols.map((c, i) => (
        <g style={`--d:${i * 60}ms`}>
          <line x1={c.x} y1="72" x2={c.x} y2="512" stroke-dasharray="14 5 3 5" />
          <circle cx={c.x} cy="52" r="16" />
          <text x={c.x} y="57" text-anchor="middle">{c.label}</text>
        </g>
      ))
    }
  </g>

  <!-- Ground -->
  <rect x="70" y={ground + 22} width="470" height="12" fill="url(#bp-hatch)" opacity="0.6"></rect>
  <line class="bp-ground draw" pathLength="1" x1="70" y1={ground + 22} x2="540" y2={ground + 22} style="--d:200ms"></line>

  <!-- Footings -->
  {cols.map((c) => <rect class="bp-footing" x={c.x - 18} y={ground + 4} width="36" height="18" />)}

  <!-- Frame: beams then columns -->
  <g class="bp-frame">
    {
      levels.slice(1).map((l, i) => (
        <line class="draw" pathLength="1" x1={left} y1={l.y} x2={right} y2={l.y} style={`--d:${350 + i * 90}ms`} />
      ))
    }
    {cols.map((c, i) => <line class="draw" pathLength="1" x1={c.x} y1={ground + 4} x2={c.x} y2={roof} style={`--d:${300 + i * 70}ms`} />)}
  </g>

  <!-- Braced bay B–C (echoes the Axisys X) -->
  <g class="bp-brace">
    <rect x="240" y="290" width="130" height="180" class="bp-bay"></rect>
    <line class="draw" pathLength="1" x1="240" y1="470" x2="370" y2="290" style="--d:900ms"></line>
    <line class="draw" pathLength="1" x1="370" y1="470" x2="240" y2="290" style="--d:1000ms"></line>
  </g>

  <!-- Connection nodes -->
  <g class="bp-nodes">
    {levels.slice(1).flatMap((l) => cols.map((c) => <rect x={c.x - 3} y={l.y - 3} width="6" height="6" />))}
  </g>

  <!-- Critical node callout -->
  <g class="bp-callout">
    <circle cx="305" cy="380" r="11"></circle>
    <line x1="291" y1="380" x2="319" y2="380"></line>
    <line x1="305" y1="366" x2="305" y2="394"></line>
    <polyline points="316,370 382,262 488,262" fill="none"></polyline>
    <rect x="378" y="216" width="114" height="42" class="bp-label-bg"></rect>
    <text x="386" y="234">BRACED BAY</text>
    <text x="386" y="251" class="bp-sub">LATERAL SYSTEM</text>
  </g>

  <!-- Level markers -->
  <g class="bp-levels">
    {
      levels.map((l) => (
        <g>
          <line x1={right + 10} y1={l.y} x2={right + 34} y2={l.y} />
          <path d={`M${right + 18} ${l.y - 9} l6 9 l6 -9 z`} />
          <text x={right + 40} y={l.y + 4}>{l.label}</text>
        </g>
      ))
    }
  </g>

  <!-- Dimension string -->
  <g class="bp-dims">
    <line x1={left} y1="548" x2={right} y2="548"></line>
    {
      cols.map((c) => (
        <>
          <line x1={c.x} y1="536" x2={c.x} y2="560" />
          <line x1={c.x - 5} y1="553" x2={c.x + 5} y2="543" class="bp-tick" />
        </>
      ))
    }
    {cols.slice(0, -1).map((c, i) => <text x={(c.x + cols[i + 1].x) / 2} y="540" text-anchor="middle">6500</text>)}
  </g>
</svg>

<style>
  .blueprint {
    width: 100%;
    height: auto;
    color: #c7ccd4;
    font-family: var(--mono);
  }

  .bp-grid line {
    stroke: #3b424e;
    stroke-width: 1;
  }

  .bp-grid circle {
    fill: var(--steel);
    stroke: #6b7483;
    stroke-width: 1.2;
  }

  .bp-grid text {
    fill: #c7ccd4;
    font-size: 14px;
    font-weight: 500;
  }

  .bp-ground {
    stroke: #8a919c;
    stroke-width: 1.5;
  }

  .bp-footing {
    fill: none;
    stroke: #6b7483;
    stroke-width: 1.2;
  }

  .bp-frame line {
    stroke: #dfe3e8;
    stroke-width: 2.6;
    stroke-linecap: square;
  }

  .bp-bay {
    fill: rgba(91, 155, 230, 0.07);
  }

  .bp-brace line {
    stroke: var(--blue-on-dark);
    stroke-width: 3.2;
    stroke-linecap: round;
  }

  .bp-nodes rect {
    fill: var(--steel);
    stroke: #dfe3e8;
    stroke-width: 1.5;
  }

  .bp-callout circle,
  .bp-callout line,
  .bp-callout polyline {
    stroke: var(--red);
    stroke-width: 1.5;
    fill: none;
  }

  .bp-label-bg {
    fill: var(--steel);
  }

  .bp-callout text {
    fill: #eef0f3;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .bp-callout .bp-sub {
    fill: #8d94a0;
    font-size: 10.5px;
    font-weight: 400;
  }

  .bp-levels line {
    stroke: #6b7483;
  }

  .bp-levels path {
    fill: #6b7483;
  }

  .bp-levels text,
  .bp-dims text {
    fill: #8d94a0;
    font-size: 11px;
  }

  .bp-dims line {
    stroke: #6b7483;
    stroke-width: 1;
  }

  .bp-dims .bp-tick {
    stroke: #c7ccd4;
    stroke-width: 1.5;
  }

  /* Line draw-in */
  .draw {
    stroke-dashoffset: 1;
    animation: bp-draw 1.1s cubic-bezier(0.6, 0.1, 0.2, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  .bp-frame .draw,
  .bp-brace .draw,
  .bp-ground.draw {
    stroke-dasharray: 1;
  }

  .bp-grid g {
    animation: bp-fade 0.8s ease both;
    animation-delay: var(--d, 0ms);
  }

  .bp-callout,
  .bp-nodes,
  .bp-levels,
  .bp-dims {
    animation: bp-fade 0.8s ease both;
    animation-delay: 1.3s;
  }

  @keyframes bp-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes bp-fade {
    from {
      opacity: 0;
    }
  }
</style>
