---
import { Image } from 'astro:assets';
import logoLight from '../assets/logo-light.png';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="site-header dark" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <Image src={logoLight} alt="" height={36} width={Math.round((36 * logoLight.width) / logoLight.height)} loading="eager" densities={[1, 2]} />
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/contact/" class="btn site-nav__cta">
        Request a quote <Icon name="ArrowRight" />
      </a>
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="menu-toggle__open"><Icon name="Menu" /></span>
      <span class="menu-toggle__close"><Icon name="X" /></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(13, 15, 19, 0.92);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line-dark);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 76px;
  }

  .brand img {
    height: 34px;
    width: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .site-nav ul {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav ul a {
    position: relative;
    display: block;
    padding: 8px 0;
    color: var(--on-dark);
    font-size: 0.97rem;
    font-weight: 520;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-nav ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    background: var(--blue-on-dark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .site-nav ul a:hover::after,
  .site-nav ul a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav__cta {
    min-height: 44px;
    padding-inline: 18px;
    font-size: 0.93rem;
  }

  .menu-toggle {
    display: none;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    margin-right: -10px;
    background: none;
    border: 0;
    color: var(--on-dark);
    cursor: pointer;
  }

  .menu-toggle__close {
    display: none;
  }

  @media (max-width: 959px) {
    /* backdrop-filter would make the fixed menu position relative to the header */
    .site-header {
      background: var(--steel);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .site-nav {
      position: fixed;
      inset: 76px 0 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
      padding: 16px var(--gutter) 40px;
      background: var(--steel);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }

    .site-nav ul a {
      padding: 18px 0;
      font-size: 1.5rem;
      font-weight: 640;
      font-stretch: 108%;
      border-bottom: 1px solid var(--line-dark);
    }

    .site-nav ul a::after {
      display: none;
    }

    .site-nav ul a[aria-current='page'] {
      color: var(--blue-on-dark);
    }

    .site-header.menu-open .site-nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .site-header.menu-open .menu-toggle__open {
      display: none;
    }

    .site-header.menu-open .menu-toggle__close {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;

  const setOpen = (open: boolean) => {
    header.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle.addEventListener('click', () => setOpen(!header.classList.contains('menu-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.matchMedia('(min-width: 960px)').addEventListener('change', () => setOpen(false));

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
