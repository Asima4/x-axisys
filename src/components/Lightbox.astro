---
import Icon from './Icon.astro';
---

<dialog class="lightbox" data-lightbox aria-label="Drawing viewer">
  <div class="lightbox__bar">
    <p class="lightbox__title"><span class="mono" data-lb-number></span> <span data-lb-title></span></p>
    <div class="lightbox__tools">
      <button type="button" data-lb-zoom="out" aria-label="Zoom out"><Icon name="ZoomOut" size={20} /></button>
      <button type="button" data-lb-zoom="in" aria-label="Zoom in"><Icon name="ZoomIn" size={20} /></button>
      <button type="button" data-lb-zoom="fit" aria-label="Fit to screen"><Icon name="Minimize2" size={20} /></button>
      <button type="button" data-lb-close aria-label="Close"><Icon name="X" size={22} /></button>
    </div>
  </div>
  <div class="lightbox__stage" data-lb-stage>
    <div class="lightbox__canvas" data-lb-canvas></div>
  </div>
  <p class="lightbox__hint mono">Scroll or pinch to zoom · drag to pan · double-click to zoom in</p>
</dialog>

<style>
  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #0b0d10;
    color: var(--on-dark);
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px var(--gutter);
    border-bottom: 1px solid var(--line-dark);
  }

  .lightbox__title {
    margin: 0;
    font-weight: 650;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lightbox__title .mono {
    color: var(--blue-on-dark);
    margin-right: 6px;
  }

  .lightbox__tools {
    display: flex;
    gap: 4px;
  }

  .lightbox__tools button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--on-dark);
    cursor: pointer;
  }

  .lightbox__tools button:hover {
    background: var(--steel-3);
  }

  .lightbox__stage {
    position: relative;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
  }

  .lightbox__stage:active {
    cursor: grabbing;
  }

  .lightbox__canvas {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
  }

  .lightbox__canvas :global(svg),
  .lightbox__canvas :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .lightbox__hint {
    margin: 0;
    padding: 10px var(--gutter);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--on-dark-2);
    text-align: center;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;
    const canvas = dialog.querySelector<HTMLElement>('[data-lb-canvas]')!;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let baseW = 0;

    // Resize (rather than CSS-scale) so SVG linework re-renders crisply at every zoom level.
    const apply = () => {
      canvas.style.width = `${baseW * scale}px`;
      canvas.style.transform = `translate(${tx}px, ${ty}px)`;
    };
    const fit = () => {
      const r = stage.getBoundingClientRect();
      const w = Math.min(r.width - 32, (r.height - 32) / ratio);
      baseW = w;
      scale = 1;
      tx = (r.width - w) / 2;
      ty = (r.height - w * ratio) / 2;
      apply();
    };
    const zoomAt = (clientX: number, clientY: number, factor: number) => {
      const r = stage.getBoundingClientRect();
      const x = clientX - r.left;
      const y = clientY - r.top;
      const next = Math.min(Math.max(scale * factor, 0.6), 10);
      const k = next / scale;
      tx = x - (x - tx) * k;
      ty = y - (y - ty) * k;
      scale = next;
      apply();
    };
    const zoomCenter = (factor: number) => {
      const r = stage.getBoundingClientRect();
      zoomAt(r.left + r.width / 2, r.top + r.height / 2, factor);
    };

    let ratio = 990 / 1400;
    const open = (content: Element, number: string, title: string, r: number) => {
      ratio = r;
      canvas.replaceChildren(content);
      dialog.querySelector('[data-lb-number]')!.textContent = number;
      dialog.querySelector('[data-lb-title]')!.textContent = title;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      requestAnimationFrame(fit);
    };

    document.querySelectorAll<HTMLButtonElement>('[data-open-sheet]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const card = btn.closest('.sheet-card')!;
        const svg = btn.querySelector('svg')!.cloneNode(true) as SVGSVGElement;
        svg.querySelectorAll('[mask]').forEach((g) => g.removeAttribute('mask'));
        svg.querySelectorAll('title').forEach((t) => t.removeAttribute('id'));
        svg.removeAttribute('aria-labelledby');
        open(svg, card.querySelector('.sheet-card__number')?.textContent ?? '', card.querySelector('h3')?.textContent ?? '', 990 / 1400);
      }),
    );

    document.querySelectorAll<HTMLButtonElement>('[data-open-image]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const img = document.createElement('img');
        img.src = btn.dataset.full!;
        img.alt = btn.dataset.caption ?? '';
        const w = Number(btn.dataset.w) || 16;
        const h = Number(btn.dataset.h) || 10;
        open(img, btn.dataset.label ?? '', btn.dataset.caption ?? '', h / w);
      }),
    );

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      canvas.replaceChildren();
    });
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelectorAll<HTMLButtonElement>('[data-lb-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        const z = b.dataset.lbZoom;
        if (z === 'fit') fit();
        else zoomCenter(z === 'in' ? 1.5 : 1 / 1.5);
      }),
    );
    window.addEventListener('resize', () => dialog.open && fit());

    stage.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        zoomAt(e.clientX, e.clientY, Math.exp(-e.deltaY * 0.0018));
      },
      { passive: false },
    );
    stage.addEventListener('dblclick', (e) => zoomAt(e.clientX, e.clientY, 2));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === '+' || e.key === '=') zoomCenter(1.3);
      if (e.key === '-') zoomCenter(1 / 1.3);
      if (e.key === '0') fit();
    });

    const pointers = new Map<number, { x: number; y: number }>();
    let pinchDist = 0;
    stage.addEventListener('pointerdown', (e) => {
      stage.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
      }
    });
    stage.addEventListener('pointermove', (e) => {
      const prev = pointers.get(e.pointerId);
      if (!prev) return;
      const cur = { x: e.clientX, y: e.clientY };
      if (pointers.size === 1) {
        tx += cur.x - prev.x;
        ty += cur.y - prev.y;
        pointers.set(e.pointerId, cur);
        apply();
      } else if (pointers.size === 2) {
        pointers.set(e.pointerId, cur);
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinchDist > 0) zoomAt((a.x + b.x) / 2, (a.y + b.y) / 2, dist / pinchDist);
        pinchDist = dist;
      }
    });
    const release = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      pinchDist = 0;
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);
  }
</script>
