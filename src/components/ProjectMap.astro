---
// US project map, rendered to SVG at build time (no map library shipped to the browser).
import { getCollection } from 'astro:content';
import { geoAlbersUsa, geoPath } from 'd3-geo';
import { feature, mesh } from 'topojson-client';
import type { Topology, GeometryCollection } from 'topojson-specification';
import statesTopo from 'us-atlas/states-albers-10m.json';

interface Props {
  heading?: boolean;
}
const { heading = true } = Astro.props;

const W = 975;
const H = 610;
const topo = statesTopo as unknown as Topology<{ states: GeometryCollection<{ name: string }>; nation: GeometryCollection }>;
const states = feature(topo, topo.objects.states).features;
const borders = mesh(topo, topo.objects.states, (a, b) => a !== b);
const nation = feature(topo, topo.objects.nation);
const path = geoPath(); // data is pre-projected (Albers USA, 975×610)
const projection = geoAlbersUsa().scale(1300).translate([487.5, 305]);

const labels: Record<string, string> = { arch: 'Architecture', str: 'Structure', mep: 'MEP', bim: 'BIM', render: 'Visualisation', scan: 'Scanning' };

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const stateOf = (location?: string) => {
  if (!location) return undefined;
  const parts = location.split(',').map((p) => p.trim()).filter((p) => p !== 'USA');
  return parts[parts.length - 1];
};
const pins = all
  .filter((p) => p.data.coords)
  .map((p) => {
    const [lat, lon] = p.data.coords!;
    const xy = projection([lon, lat]);
    return {
      id: p.id,
      title: p.data.title,
      place: (p.data.location ?? '').replace(', USA', ''),
      sector: p.data.sector,
      disciplines: p.data.disciplines.filter((d) => d !== 'render').map((d) => labels[d]),
      state: stateOf(p.data.location),
      x: xy ? xy[0] : 0,
      y: xy ? xy[1] : 0,
    };
  })
  .filter((p) => p.x > 0);

const activeStates = new Set(pins.map((p) => p.state));
const stateCount = activeStates.size;
const disciplineCount = new Set(all.flatMap((p) => p.data.disciplines.filter((d) => d !== 'render'))).size;
---

<section class="section dark map-section" id="map">
  <div class="container">
    {
      heading && (
        <div class="section-head section-head--split reveal">
          <div>
            <p class="eyebrow">Where we’ve worked</p>
            <h2>Projects across {stateCount} US states.</h2>
          </div>
          <dl class="map-stats">
            <div>
              <dt class="mono">Projects</dt>
              <dd>{all.length}</dd>
            </div>
            <div>
              <dt class="mono">States</dt>
              <dd>{stateCount}</dd>
            </div>
            <div>
              <dt class="mono">Disciplines</dt>
              <dd>{disciplineCount}</dd>
            </div>
          </dl>
        </div>
      )
    }

    <div class="map" data-map>
      <div class="map__canvas reveal">
        <svg viewBox={`0 0 ${W} ${H}`} class="map__svg" role="img" aria-label={`Map of the United States showing ${pins.length} Axisys project locations`}>
          <defs>
            <pattern id="map-grid" width="24" height="24" patternUnits="userSpaceOnUse">
              <path d="M24 0H0V24" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"></path>
            </pattern>
          </defs>
          <rect width={W} height={H} fill="url(#map-grid)"></rect>
          <path d={path(nation) ?? ''} class="map__nation"></path>
          {states.map((s) => <path d={path(s) ?? ''} class:list={['map__state', { 'is-active': activeStates.has(s.properties.name) }]} />)}
          <path d={path(borders) ?? ''} class="map__borders"></path>
        </svg>

        {
          pins.map((p, i) => (
            <a
              class="map__pin"
              href={`/projects/${p.id}/`}
              style={`left:${(p.x / W) * 100}%;top:${(p.y / H) * 100}%;--d:${i * 120}ms`}
              data-pin={p.id}
              aria-label={`${p.title}, ${p.place}`}
            >
              <span class="map__dot" />
              <span class="map__tip">
                <span class="map__tip-place mono">{p.place}</span>
                <span class="map__tip-title">{p.title}</span>
                <span class="map__tip-meta">{p.disciplines.join(' · ')}</span>
              </span>
            </a>
          ))
        }
      </div>

      <ol class="map__list">
        {
          pins.map((p, i) => (
            <li>
              <a href={`/projects/${p.id}/`} data-pin-link={p.id}>
                <span class="map__num mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="map__list-text">
                  <span class="map__list-title">{p.title}</span>
                  <span class="map__list-place mono">{p.place}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .map-section {
    overflow: hidden;
  }

  .map-stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 8px clamp(28px, 5vw, 64px);
    margin: 0;
  }

  @media (min-width: 900px) {
    .map-stats {
      justify-content: end;
    }
  }

  .map-stats dt {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .map-stats dd {
    margin: 0;
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-weight: 800;
    font-stretch: 115%;
    line-height: 1;
    color: var(--on-dark);
  }

  .map {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 1000px) {
    .map {
      grid-template-columns: 1fr 320px;
      gap: 48px;
    }
  }

  .map__canvas {
    position: relative;
  }

  .map__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .map__nation {
    fill: none;
    stroke: #3a414d;
    stroke-width: 1.2;
  }

  .map__state {
    fill: #161a21;
    transition: fill 0.3s ease;
  }

  .map__state.is-active {
    fill: #1d2a3d;
  }

  .map__borders {
    fill: none;
    stroke: #2c323c;
    stroke-width: 0.8;
    stroke-linejoin: round;
  }

  .map__pin {
    position: absolute;
    width: 0;
    height: 0;
    z-index: 1;
    text-decoration: none;
  }

  .map__pin:hover,
  .map__pin:focus-visible,
  .map__pin.is-hot {
    z-index: 3;
  }

  .map__dot {
    position: absolute;
    left: -8px;
    top: -8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--red);
    border: 3px solid #fff;
    box-shadow: 0 0 0 0 rgba(232, 56, 58, 0.6);
    transform: scale(0);
    transition: transform 0.2s ease;
  }

  .map__canvas:global(.is-visible) .map__dot {
    animation:
      pin-drop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) var(--d) forwards,
      pin-pulse 2.8s ease-out calc(var(--d) + 0.6s) infinite;
  }

  :global(.no-js) .map__dot {
    transform: none;
  }

  @keyframes pin-drop {
    from {
      transform: translateY(-30px) scale(0.4);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes pin-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(232, 56, 58, 0.55);
    }
    70%,
    100% {
      box-shadow: 0 0 0 16px rgba(232, 56, 58, 0);
    }
  }

  .map__pin:hover .map__dot,
  .map__pin:focus-visible .map__dot,
  .map__pin.is-hot .map__dot {
    background: var(--blue-on-dark);
  }

  .map__tip {
    position: absolute;
    left: 50%;
    bottom: 16px;
    display: grid;
    gap: 2px;
    width: max-content;
    max-width: 240px;
    padding: 10px 14px;
    border-radius: 4px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    transform: translate(-50%, 6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .map__pin:hover .map__tip,
  .map__pin:focus-visible .map__tip,
  .map__pin.is-hot .map__tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .map__tip-place {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .map__tip-title {
    font-weight: 700;
    font-size: 0.98rem;
    line-height: 1.25;
  }

  .map__tip-meta {
    font-size: 0.8rem;
    color: var(--blue);
    font-weight: 600;
  }

  .map__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line-dark);
  }

  @media (min-width: 640px) and (max-width: 999px) {
    .map__list {
      grid-template-columns: 1fr 1fr;
      column-gap: 24px;
    }
  }

  .map__list a {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 10px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-dark);
    color: var(--on-dark);
    text-decoration: none;
  }

  .map__list a:hover,
  .map__list a.is-hot {
    color: var(--blue-on-dark);
  }

  .map__num {
    font-size: 0.75rem;
    color: var(--on-dark-2);
    padding-top: 3px;
  }

  .map__list-text {
    display: grid;
    gap: 2px;
  }

  .map__list-title {
    font-weight: 650;
    line-height: 1.3;
  }

  .map__list-place {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--on-dark-2);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const pins = map.querySelectorAll<HTMLElement>('[data-pin]');
    const links = map.querySelectorAll<HTMLElement>('[data-pin-link]');
    const hot = (id: string | null) => {
      pins.forEach((p) => p.classList.toggle('is-hot', p.dataset.pin === id));
      links.forEach((l) => l.classList.toggle('is-hot', l.dataset.pinLink === id));
    };
    links.forEach((l) => {
      l.addEventListener('mouseenter', () => hot(l.dataset.pinLink!));
      l.addEventListener('focus', () => hot(l.dataset.pinLink!));
      l.addEventListener('mouseleave', () => hot(null));
      l.addEventListener('blur', () => hot(null));
    });
    pins.forEach((p) => {
      p.addEventListener('mouseenter', () => hot(p.dataset.pin!));
      p.addEventListener('mouseleave', () => hot(null));
    });
  });
</script>
