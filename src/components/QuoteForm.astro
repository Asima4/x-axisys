---
import Icon from './Icon.astro';
import '../styles/forms.css';
import { quoteServiceOptions } from '../data/site';

const timelines = ['As soon as possible', 'Within 1–3 months', 'Within 3–6 months', '6 months or more', 'Just exploring'];
---

<form class="form" name="quote" action="/thank-you/" method="post" data-netlify="true" netlify-honeypot="website" data-ajax-form novalidate>
  <input type="hidden" name="form-name" value="quote" />
  <input type="hidden" name="form_type" value="quote" />
  <input type="hidden" name="started" value="" data-started />
  <div class="form__hp" aria-hidden="true">
    <label for="q-website">Leave this field empty</label>
    <input id="q-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <fieldset>
    <legend>Your details</legend>
    <div class="form__grid">
      <div class="field">
        <label for="q-name">Full name <span aria-hidden="true">*</span></label>
        <input id="q-name" name="name" type="text" autocomplete="name" required maxlength="120" />
      </div>
      <div class="field">
        <label for="q-email">Email <span aria-hidden="true">*</span></label>
        <input id="q-email" name="email" type="email" autocomplete="email" required maxlength="160" />
      </div>
      <div class="field">
        <label for="q-phone">Phone / WhatsApp</label>
        <input id="q-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
      </div>
      <div class="field">
        <label for="q-company">Company</label>
        <input id="q-company" name="company" type="text" autocomplete="organization" maxlength="160" />
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Your project</legend>
    <div class="form__grid">
      <div class="field">
        <label for="q-service">Service needed <span aria-hidden="true">*</span></label>
        <select id="q-service" name="service" required>
          <option value="">Select a service</option>
          {quoteServiceOptions.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="q-timeline">Timeline</label>
        <select id="q-timeline" name="timeline">
          <option value="">Select a timeline</option>
          {timelines.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>
      <div class="field field--full">
        <label for="q-location">Project location</label>
        <input id="q-location" name="location" type="text" placeholder="City, country" maxlength="160" />
      </div>
      <div class="field field--full">
        <label for="q-message">Project details <span aria-hidden="true">*</span></label>
        <textarea
          id="q-message"
          name="message"
          rows="6"
          required
          minlength="20"
          maxlength="5000"
          placeholder="Building type, size, stage (concept, permit, construction), and what you need from us."
        ></textarea>
      </div>
    </div>
  </fieldset>

  <div class="form__footer">
    <p class="form__note">
      By sending this form you agree to us using your details to respond to your enquiry. See our <a href="/privacy-policy/">Privacy Policy</a>.
    </p>
    <button class="btn" type="submit" data-submit>
      <span data-label>Send enquiry</span>
      <Icon name="Send" />
    </button>
  </div>
  <p class="form__status" role="status" aria-live="polite" data-status></p>
</form>

<script>
  import '../scripts/forms.ts';
</script>
