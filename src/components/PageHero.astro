---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero dark">
  <div class="container page-hero__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 10vw, 120px) clamp(56px, 8vw, 96px);
    background-color: var(--steel);
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: -1px -1px;
  }

  .page-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 90% at 15% 30%, transparent 30%, var(--steel) 85%);
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .page-hero h1 {
    max-width: 20ch;
    font-size: clamp(2.3rem, 5vw, 4.1rem);
  }
</style>
