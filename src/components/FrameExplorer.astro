---
// Interactive framing anatomy, built member by member: a two-storey wood house (src/scripts/woodFrame.ts)
// or a two-storey structural steel building (src/scripts/steelFrame.ts).
import Icon from './Icon.astro';
import ArView from './ArView.astro';
import { GROUPS, MEMBERS, type Member } from '../data/woodFrame';
import { STEEL_GROUPS, STEEL_MEMBERS } from '../data/steelFrame';

interface Props {
  kind?: 'wood' | 'steel';
}
const { kind = 'wood' } = Astro.props;
const CFG = {
  wood: {
    members: MEMBERS as Record<string, Member>,
    groups: GROUPS as string[],
    eyebrow: 'Light-frame anatomy',
    title: 'Every member of a wood-frame house.',
    lead: 'A sample two-storey home with an attached garage, framed piece by piece the way we detail it — from anchor bolts to hurricane ties. Select any member to isolate it and see what it does.',
    loading: 'Framing the model…',
    cardTitle: 'Two-storey wood frame + garage',
    cardText: 'Slab-on-grade, 2x6 exterior walls at 16" centres, 2x10 floor joists, a stick-framed 6:12 main roof and a trussed garage roof — with the connectors that complete the load path.',
    details: 11,
    loads: true,
    ar: { id: 'wood-frame', src: '/models/ar/wood-frame.glb', title: 'Wood-frame sample house', scale: '1:40 tabletop scale' },
    note: 'Illustrative sample using typical light-frame details. Connectors are modelled on Simpson Strong-Tie® products commonly specified for light-frame construction. Member sizes are typical, not a design for any specific building.',
  },
  steel: {
    members: STEEL_MEMBERS as Record<string, Member>,
    groups: STEEL_GROUPS,
    eyebrow: 'Steel-frame anatomy',
    title: 'Inside a structural steel building.',
    lead: 'A sample two-storey steel building — footings and base plates, W-shape columns and girders, a composite floor, open-web roof joists and chevron braced frames, down to every shear tab and bolt. Select any member to isolate it and open its section detail.',
    loading: 'Erecting the steel…',
    cardTitle: 'Two-storey steel frame',
    cardText: 'Three bays by two with 14 ft storeys: W12 columns, W21 girders, W16 composite beams at 10 ft, 18K roof joists at 5 ft and HSS chevron braces in both directions.',
    details: 7,
    loads: false,
    ar: { id: 'steel-frame', src: '/models/ar/steel-frame.glb', title: 'Steel-frame sample building', scale: '1:75 tabletop scale' },
    note: 'Illustrative sample using typical structural steel details. Member sizes are typical, not a design for any specific building.',
  },
}[kind];
const entries = Object.entries(CFG.members);
---

<section class="section wf dark" data-wf data-wf-kind={kind} aria-labelledby={`wf-title-${kind}`}>
  <div class="container">
    <div class="section-head section-head--split reveal">
      <div>
        <p class="eyebrow">{CFG.eyebrow}</p>
        <h2 id={`wf-title-${kind}`}>{CFG.title}</h2>
      </div>
      <p class="lead">{CFG.lead}</p>
    </div>

    <div class="wf__layout">
      <div class="wf__stage" data-wf-stage>
        <div class="wf__loading mono" data-wf-loading>{CFG.loading}</div>
        <div class="wf__tip mono" data-wf-tip hidden></div>
        <div class="wf__pin" data-wf-pin hidden><span></span></div>
        <div class="wf__progress" aria-hidden="true"><span data-wf-bar></span></div>
        <div class="wf__controls">
          <button type="button" data-wf-replay><Icon name="RotateCcw" size={16} /> <span>Replay build</span></button>
          <button type="button" data-wf-explode aria-pressed="false"><Icon name="Layers" size={16} /> <span>Exploded view</span></button>
          <button type="button" class="wf__icon-btn" data-wf-zoom="1" aria-label="Zoom in"><Icon name="Plus" size={16} /></button>
          <button type="button" class="wf__icon-btn" data-wf-zoom="-1" aria-label="Zoom out"><Icon name="Minus" size={16} /></button>
          <ArView id={CFG.ar.id} src={CFG.ar.src} title={CFG.ar.title} scale={CFG.ar.scale} variant="overlay" />
        </div>
        <div class="wf__loads" role="group" aria-label="Show load path" hidden={!CFG.loads}>
          <span class="wf__loads-label mono">Load path</span>
          <button type="button" data-wf-load="gravity" aria-pressed="false"><Icon name="ArrowDownToLine" size={16} /> <span>Gravity</span></button>
          <button type="button" data-wf-load="wind" aria-pressed="false"><Icon name="Wind" size={16} /> <span>Wind</span></button>
          <button type="button" data-wf-load="seismic" aria-pressed="false"><Icon name="Activity" size={16} /> <span>Seismic</span></button>
        </div>
        <div class="wf__lp" data-wf-lp hidden aria-live="polite">
          <p class="wf__lp-kicker mono" data-wf-lp-kicker></p>
          <h3 data-wf-lp-title></h3>
          <ol data-wf-lp-steps></ol>
          <ul class="wf__lp-key mono">
            <li><span class="wf__lp-sw" data-wf-lp-sw></span> Applied load</li>
            <li><span class="wf__lp-dot" data-wf-lp-dot></span> Load path</li>
            <li><span class="wf__lp-sw" style="--c:#9be15d"></span> Reaction</li>
          </ul>
        </div>
        <p class="wf__hint mono" aria-hidden="true">Scroll to zoom · drag to rotate · right-drag to pan · click any member</p>
      </div>

      <aside class="wf__panel" aria-label="Framing members">
        <div class="wf__card" data-wf-card aria-live="polite">
          <p class="wf__card-group mono">Sample model</p>
          <h3>{CFG.cardTitle}</h3>
          <p>{CFG.cardText}</p>
          <dl>
            <div><dt class="mono">Pieces</dt><dd data-wf-total>—</dd></div>
            <div><dt class="mono">Member types</dt><dd>{entries.length}</dd></div>
          </dl>
          <button type="button" class="wf__detail-btn" data-wf-open="1"><Icon name="FileText" size={16} /> Browse the {CFG.details} section details</button>
        </div>
        <div class="wf__legend">
          {
            CFG.groups.map((g) => (
              <div class="wf__group">
                <h3 class="mono">{g}</h3>
                <ul>
                  {entries
                    .filter(([, m]) => m.group === g)
                    .map(([id, m]) => (
                      <li>
                        <button type="button" data-wf-member={id} aria-pressed="false">
                          <span class="wf__sw" style={`--c:${m.color}`} />
                          {m.name}
                        </button>
                      </li>
                    ))}
                </ul>
              </div>
            ))
          }
        </div>
        <button type="button" class="wf__reset" data-wf-reset hidden><Icon name="Eye" size={16} /> Show all members</button>
      </aside>
    </div>
    <p class="wf__note mono">
      {CFG.note}
    </p>
  </div>

  <dialog class="wfd" data-wfd aria-labelledby={`wfd-title-${kind}`}>
    <div class="wfd__head">
      <div>
        <p class="wfd__kicker mono" data-wfd-kicker>Section detail</p>
        <h3 id={`wfd-title-${kind}`} data-wfd-title>Section detail</h3>
      </div>
      <button type="button" class="wfd__close" data-wfd-close aria-label="Close detail"><Icon name="X" size={20} /></button>
    </div>
    <div class="wfd__sheet" data-wfd-sheet></div>
    <div class="wfd__foot">
      <p class="wfd__member" data-wfd-member></p>
      <nav class="wfd__nav" aria-label="Section details">
        <button type="button" data-wfd-step="-1" aria-label="Previous detail"><Icon name="ChevronLeft" size={18} /></button>
        <ol data-wfd-list></ol>
        <button type="button" data-wfd-step="1" aria-label="Next detail"><Icon name="ChevronRight" size={18} /></button>
      </nav>
    </div>
  </dialog>
</section>

<style>
  .wf__layout {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 1000px) {
    .wf__layout {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 20px;
    }
  }

  .wf__stage {
    position: relative;
    height: clamp(420px, 62vw, 680px);
    overflow: hidden;
    border: 1px solid var(--line-dark);
    background:
      radial-gradient(ellipse at 50% 35%, rgba(91, 155, 230, 0.09), transparent 60%),
      var(--steel);
  }

  .wf__stage :global(.wf__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }

  .wf__stage :global(.wf__canvas:active) {
    cursor: grabbing;
  }

  .wf__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-2);
    transition: opacity 0.4s;
  }

  .wf__stage.is-ready .wf__loading {
    opacity: 0;
    pointer-events: none;
  }

  .wf__tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    padding: 6px 10px;
    background: rgba(13, 15, 19, 0.92);
    border: 1px solid var(--line-dark);
    color: var(--on-dark);
    font-size: 0.74rem;
    pointer-events: none;
    white-space: nowrap;
  }

  .wf__pin {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .wf__pin::before {
    content: '';
    position: absolute;
    left: -6px;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--blue-on-dark);
    box-shadow: 0 0 0 5px rgba(91, 155, 230, 0.28);
    animation: wf-pulse 1.8s ease-out infinite;
  }

  .wf__pin span {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 6px 10px;
    background: var(--blue);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  @keyframes wf-pulse {
    70% {
      box-shadow: 0 0 0 14px rgba(91, 155, 230, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(91, 155, 230, 0);
    }
  }

  .wf__progress {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    z-index: 2;
    background: rgba(255, 255, 255, 0.06);
  }

  .wf__progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--blue-on-dark), var(--red));
    transform: scaleX(0);
    transform-origin: left;
  }

  .wf__controls {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wf__controls button,
  .wf__reset {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-dark);
    background: rgba(13, 15, 19, 0.82);
    color: var(--on-dark);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }

  .wf__controls button:hover,
  .wf__reset:hover {
    border-color: var(--blue-on-dark);
  }

  .wf__controls button[aria-pressed='true'] {
    background: var(--blue);
    border-color: var(--blue);
  }

  .wf__controls .wf__icon-btn {
    width: 40px;
    padding: 0;
    justify-content: center;
  }

  .wf__loads[hidden] {
    display: none;
  }

  .wf__loads {
    position: absolute;
    right: 14px;
    top: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border: 1px solid var(--line-dark);
    background: rgba(13, 15, 19, 0.82);
    backdrop-filter: blur(6px);
  }

  .wf__loads-label {
    padding: 0 6px;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .wf__loads button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--on-dark);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }

  .wf__loads button:hover {
    border-color: var(--line-dark);
  }

  .wf__loads button[data-wf-load='gravity'][aria-pressed='true'] {
    background: #1d4f8c;
  }

  .wf__loads button[data-wf-load='wind'][aria-pressed='true'] {
    background: #136c64;
  }

  .wf__loads button[data-wf-load='seismic'][aria-pressed='true'] {
    background: #a3341c;
  }

  .wf__lp {
    position: absolute;
    left: 14px;
    top: 16px;
    z-index: 2;
    width: min(330px, calc(100% - 28px));
    padding: 14px 16px;
    border: 1px solid var(--line-dark);
    border-left: 3px solid var(--lp, var(--blue-on-dark));
    background: rgba(13, 15, 19, 0.86);
    backdrop-filter: blur(6px);
    color: var(--on-dark);
  }

  .wf__lp[hidden] {
    display: none;
  }

  .wf__lp-kicker {
    margin: 0 0 4px;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lp, var(--blue-on-dark));
  }

  .wf__lp h3 {
    margin: 0 0 8px;
    font-size: 1.05rem;
  }

  .wf__lp ol {
    display: grid;
    gap: 3px;
    margin: 0 0 10px;
    padding-left: 18px;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--on-dark-2);
  }

  .wf__lp-key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0;
    padding: 8px 0 0;
    border-top: 1px solid var(--line-dark);
    list-style: none;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .wf__lp-key li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .wf__lp-sw {
    width: 14px;
    height: 3px;
    background: var(--c, var(--lp));
  }

  .wf__lp-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lp);
    box-shadow: 0 0 8px var(--lp);
  }

  .wf__stage.has-load .wf__hint {
    display: none;
  }

  .wf__loads:not([hidden]) ~ .wf__hint {
    top: 66px;
  }

  .wf__hint {
    position: absolute;
    right: 14px;
    top: 16px;
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--on-dark-2);
    pointer-events: none;
  }

  .wf__panel {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  @media (min-width: 1000px) {
    .wf__panel {
      max-height: clamp(420px, 62vw, 680px);
      grid-template-rows: auto minmax(0, 1fr) auto;
    }
  }

  .wf__card {
    padding: 20px;
    border: 1px solid var(--line-dark);
    border-top: 3px solid var(--blue-on-dark);
    background: var(--steel-2);
  }

  .wf__card :global(.wf__card-group) {
    margin: 0 0 6px;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-on-dark);
  }

  .wf__card :global(h3) {
    margin: 0 0 8px;
    font-size: 1.25rem;
    color: var(--on-dark);
  }

  .wf__card :global(p:not(.wf__card-group)) {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--on-dark-2);
  }

  .wf__card :global(dl) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--line-dark);
  }

  .wf__card :global(dt) {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .wf__card :global(dd) {
    margin: 4px 0 0;
    font-weight: 700;
    color: var(--on-dark);
  }

  .wf__legend {
    display: grid;
    gap: 14px;
    overflow: auto;
    padding-right: 4px;
    scrollbar-width: thin;
  }

  .wf__group h3 {
    margin: 0 0 6px;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .wf__group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wf__group button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 0 11px;
    border: 1px solid var(--line-dark);
    background: transparent;
    color: var(--on-dark);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .wf__group button:hover {
    border-color: var(--on-dark-2);
  }

  .wf__group button[aria-pressed='true'] {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  .wf__sw {
    width: 10px;
    height: 10px;
    flex: none;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  .wf__reset {
    justify-content: center;
  }

  .wf__card :global(.wf__detail-btn) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid var(--blue-on-dark);
    background: transparent;
    color: var(--on-dark);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .wf__card :global(.wf__detail-btn:hover) {
    background: var(--blue);
    border-color: var(--blue);
  }

  /* ----- section detail sheet ----- */
  .wfd {
    width: min(1180px, 96vw);
    max-width: 96vw;
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: #fbfaf6;
    color: var(--ink);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .wfd::backdrop {
    background: rgba(8, 10, 13, 0.72);
    backdrop-filter: blur(3px);
  }

  .wfd[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    animation: wfd-in 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes wfd-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.985);
    }
  }

  .wfd__head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 16px;
    padding: 16px 20px 10px;
    border-bottom: 1px solid var(--line);
  }

  .wfd__kicker {
    margin: 0 0 2px;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .wfd__head h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--ink);
  }

  .wfd__close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
  }

  .wfd__close:hover {
    border-color: var(--ink);
  }

  .wfd__sheet {
    min-height: 0;
    overflow: auto;
    padding: 10px 14px;
  }

  .wfd__sheet :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(94vh - 170px);
    margin: 0 auto;
  }

  .wfd__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 16px;
    padding: 10px 20px 14px;
    border-top: 1px solid var(--line);
  }

  .wfd__member {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-2);
  }

  .wfd__member :global(b) {
    color: var(--blue);
  }

  .wfd__nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .wfd__nav > button,
  .wfd__nav :global(ol button) {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 32px;
    padding: 0 6px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    font: 600 0.8rem var(--mono);
    cursor: pointer;
  }

  .wfd__nav ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wfd__nav :global(ol button[aria-current='true']) {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  /* drawing conventions */
  .wfd :global(.det) {
    background: #fff;
  }

  .wfd :global(.det .frame) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 1.6;
  }

  .wfd :global(.det .frame2) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.5;
  }

  .wfd :global(.det .o) {
    fill: #fff;
    stroke: #1d2025;
    stroke-width: 1.05;
    stroke-linejoin: round;
  }

  .wfd :global(.det .cut) {
    stroke-width: 1.7;
  }

  .wfd :global(.det .xh),
  .wfd :global(.det .thin) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.55;
  }

  .wfd :global(.det .stc) {
    fill: #343941;
    stroke: #1d2025;
    stroke-width: 0.8;
  }

  .wfd :global(.det .stb) {
    fill: #1d2025;
  }

  .wfd :global(.det .grout) {
    fill: #e4e0d3;
    stroke: #1d2025;
    stroke-width: 0.9;
  }

  .wfd :global(.det .deckl) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 2.2;
    stroke-linejoin: round;
  }

  .wfd :global(.det .wwf) {
    stroke: #1d2025;
    stroke-width: 0.8;
    stroke-dasharray: 2 3;
  }

  .wfd :global(.det .hl.stc),
  .wfd :global(.det .hl.stb) {
    fill: #2f76c8;
  }

  .wfd :global(.det .hl.deckl),
  .wfd :global(.det .hl.wwf) {
    fill: none;
    stroke: #2f76c8;
  }

  .wfd :global(.det .ply) {
    fill: url(#d-ply);
    stroke: #1d2025;
    stroke-width: 0.9;
  }

  .wfd :global(.det .st) {
    fill: #7f8892;
    stroke: #1d2025;
    stroke-width: 0.9;
  }

  .wfd :global(.det .st2) {
    fill: rgba(127, 136, 146, 0.5);
    stroke: #1d2025;
    stroke-width: 0.9;
  }

  .wfd :global(.det .stl) {
    fill: none;
    stroke: #59616a;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wfd :global(.det .hid) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.8;
    stroke-dasharray: 6 3;
  }

  .wfd :global(.det .conc) {
    fill: url(#d-conc);
    stroke: #1d2025;
    stroke-width: 1.5;
  }

  .wfd :global(.det .earth) {
    fill: url(#d-earth);
  }

  .wfd :global(.det .grade) {
    stroke: #1d2025;
    stroke-width: 1.8;
  }

  .wfd :global(.det .roof) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 2.2;
  }

  .wfd :global(.det .brk) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.8;
  }

  .wfd :global(.det .ld) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.7;
  }

  .wfd :global(.det .dot) {
    fill: #1d2025;
  }

  .wfd :global(.det .tx) {
    font: 500 10.5px 'IBM Plex Mono', ui-monospace, monospace;
    fill: #1d2025;
    letter-spacing: 0.02em;
  }

  .wfd :global(.det .bg) {
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 5px;
  }

  .wfd :global(.det .nail) {
    font: 700 16px sans-serif;
    fill: #1d2025;
  }

  .wfd :global(.det .dim line) {
    stroke: #1d2025;
    stroke-width: 0.6;
  }

  .wfd :global(.det .dim .tk) {
    stroke-width: 1.3;
  }

  .wfd :global(.det .bub) {
    fill: #fff;
    stroke: #1d2025;
    stroke-width: 1.5;
  }

  .wfd :global(.det .bubl) {
    stroke: #1d2025;
    stroke-width: 1;
  }

  .wfd :global(.det .bubn) {
    font: 700 15px 'IBM Plex Mono', ui-monospace, monospace;
    fill: #1d2025;
  }

  .wfd :global(.det .bubs) {
    font: 500 9px 'IBM Plex Mono', ui-monospace, monospace;
    fill: #1d2025;
  }

  .wfd :global(.det .ttl) {
    font: 700 15px 'IBM Plex Mono', ui-monospace, monospace;
    fill: #1d2025;
    letter-spacing: 0.03em;
  }

  .wfd :global(.det .ttll) {
    stroke: #1d2025;
    stroke-width: 1.4;
  }

  /* selected member, highlighted in the drawing */
  .wfd :global(.det .hl:not(.note):not(g)),
  .wfd :global(.det g.hl:not(.note) polygon) {
    fill: #d5e5f7;
    stroke: #004e92;
    stroke-width: 2;
  }

  .wfd :global(.det .hl.st),
  .wfd :global(.det .hl.st2) {
    fill: #2f76c8;
  }

  .wfd :global(.det .hl.stl) {
    fill: none;
    stroke: #2f76c8;
  }

  .wfd :global(.det .hl.hid),
  .wfd :global(.det .hl.thin) {
    fill: none;
  }

  .wfd :global(.det .hl.ply) {
    fill: #9cc2ea;
  }

  .wfd :global(.det .note.hl .tx) {
    fill: #004e92;
    font-weight: 700;
  }

  .wfd :global(.det .note.hl .ld) {
    stroke: #004e92;
