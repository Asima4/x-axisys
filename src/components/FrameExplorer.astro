---
// Interactive framing anatomy, built member by member: a two-storey wood house (src/scripts/woodFrame.ts)
// or a two-storey structural steel building (src/scripts/steelFrame.ts).
import Icon from './Icon.astro';
import ArView from './ArView.astro';
import { GROUPS, MEMBERS, type Member } from '../data/woodFrame';
import { STEEL_GROUPS, STEEL_MEMBERS } from '../data/steelFrame';
import { MEP_GROUPS, MEP_MEMBERS } from '../data/mepModel';

interface Props {
  kind?: 'wood' | 'steel' | 'mep';
}
const { kind = 'wood' } = Astro.props;
type Flow = { id: string; label: string; icon: string; color: string; kicker: string; title: string; steps: string[]; key?: [string, string, string] };
const WOOD_FLOWS: Flow[] = [
  {
    id: 'gravity',
    label: 'Gravity',
    icon: 'ArrowDownToLine',
    color: '#5b9be6',
    kicker: 'Load path · Gravity',
    title: 'Roof and floor loads down to the soil',
    steps: [
      'Roof dead + snow load on the rafters and garage trusses',
      'Rafters bear on the top plate (H2.5A ties) and the ridge (LSSU210)',
      'Floor joists carry the second floor to the rim and centre bearing wall',
      'Studs, king studs and trimmers take it down both storeys',
      'Sill plate → slab and thickened footing → soil',
    ],
  },
  {
    id: 'wind',
    label: 'Wind',
    icon: 'Wind',
    color: '#35d0c0',
    kicker: 'Load path · Wind',
    title: 'Lateral pressure and roof uplift',
    steps: [
      'Wind pressure on the wall is collected by the floor and roof diaphragms',
      'LTP4 ties and A35 clips pass the shear into the wall top plates',
      'Sheathed shear walls carry it to the foundation',
      'HDU5 hold-downs and MSTC48B3 straps resist overturning',
      'Roof uplift is tied down by H2.5A ties and LSTA21 ridge straps',
    ],
  },
  {
    id: 'seismic',
    label: 'Seismic',
    icon: 'Activity',
    color: '#ff6a45',
    kicker: 'Load path · Seismic',
    title: 'Inertial forces from the building’s own mass',
    steps: [
      'Ground shaking makes the mass sway — forces grow with height',
      'Roof and floor diaphragms deliver the storey forces to the shear walls',
      'Shear walls carry them down, MSTC48B3 straps across the floor',
      'HDU5 hold-downs anchor the wall ends against overturning',
      'Anchor bolts deliver base shear into the foundation',
    ],
  },
];
const MEP_FLOWS: Flow[] = [
  {
    id: 'air',
    key: ['Supply / diffuser', 'Air flow', 'Return grille'],
    label: 'Air',
    icon: 'Fan',
    color: '#4f9de0',
    kicker: 'Flow · Air',
    title: 'Supply and return air',
    steps: [
      'The AHU filters and conditions the air in the mechanical room',
      'The supply trunk runs through the plenum, below the beams',
      'VAV boxes meter the airflow to each zone',
      'Flex ducts feed the ceiling diffusers',
      'Return grilles bring air back through the return main to the AHU',
    ],
  },
  {
    id: 'water',
    key: ['Outlet', 'Water flow', 'Return'],
    label: 'Water',
    icon: 'Droplets',
    color: '#2fb4a5',
    kicker: 'Flow · Water',
    title: 'Hydronic and domestic water',
    steps: [
      'Chilled and heating hot water rise from the central plant',
      'Insulated mains run above the ducts to the AHU coils',
      'Domestic water runs from the water heater to the restroom',
      'Each fixture gets its own branch and drop',
      'Sanitary drains by gravity below the slab',
    ],
  },
  {
    id: 'fire',
    key: ['Sprinkler discharge', 'Water flow', 'Return'],
    label: 'Fire',
    icon: 'Flame',
    color: '#e2483a',
    kicker: 'Flow · Fire protection',
    title: 'Sprinkler water from riser to heads',
    steps: [
      'The fire riser rises at the building corner',
      'The cross main runs high, just below the beams',
      'Branch lines run above all other services',
      'Drops feed a pendent head in the ceiling',
      'Spacing and pipe sizes come from the NFPA 13 hydraulic calculation',
    ],
  },
  {
    id: 'power',
    key: ['Load', 'Power flow', 'Return'],
    label: 'Power',
    icon: 'Zap',
    color: '#f2c14e',
    kicker: 'Flow · Power',
    title: 'Power from panel to light',
    steps: [
      'Panelboards in the electrical room feed the floor',
      'Conduit rises above the piping to the cable tray',
      'The ladder tray carries power and data along the corridor',
      'Branch conduits drop to each row of fixtures',
      'Flexible whips connect the LED troffers in the ceiling',
    ],
  },
];
const CFG = {
  wood: {
    members: MEMBERS as Record<string, Member>,
    groups: GROUPS as string[],
    eyebrow: 'Light-frame anatomy',
    title: 'Every member of a wood-frame house.',
    lead: 'A sample two-storey home with an attached garage, framed piece by piece the way we detail it — from anchor bolts to hurricane ties. Select any member to isolate it and see what it does.',
    loading: 'Framing the model…',
    cardTitle: 'Two-storey wood frame + garage',
    cardText: 'Slab-on-grade, 2x6 exterior walls at 16" centres, 2x10 floor joists, a stick-framed 6:12 main roof and a trussed garage roof — with the connectors that complete the load path.',
    details: 11,
    flows: WOOD_FLOWS,
    flowsLabel: 'Load path',
    ar: { id: 'wood-frame', src: '/models/ar/wood-frame.glb', title: 'Wood-frame sample house', scale: '1:40 tabletop scale' },
    note: 'Illustrative sample using typical light-frame details. Connectors are modelled on Simpson Strong-Tie® products commonly specified for light-frame construction. Member sizes are typical, not a design for any specific building.',
  },
  steel: {
    members: STEEL_MEMBERS as Record<string, Member>,
    groups: STEEL_GROUPS,
    eyebrow: 'Steel-frame anatomy',
    title: 'Inside a structural steel building.',
    lead: 'A sample two-storey steel building — footings and base plates, W-shape columns and girders, a composite floor, open-web roof joists and chevron braced frames, down to every shear tab and bolt. Select any member to isolate it and open its section detail.',
    loading: 'Erecting the steel…',
    cardTitle: 'Two-storey steel frame',
    cardText: 'Three bays by two with 14 ft storeys: W12 columns, W21 girders, W16 composite beams at 10 ft, 18K roof joists at 5 ft and HSS chevron braces in both directions.',
    details: 7,
    flows: [] as Flow[],
    flowsLabel: '',
    ar: { id: 'steel-frame', src: '/models/ar/steel-frame.glb', title: 'Steel-frame sample building', scale: '1:75 tabletop scale' },
    note: 'Illustrative sample using typical structural steel details. Member sizes are typical, not a design for any specific building.',
  },
  mep: {
    members: MEP_MEMBERS as Record<string, Member>,
    groups: MEP_GROUPS,
    eyebrow: 'MEP & BIM coordination',
    title: 'Every system above the ceiling, coordinated in 3D.',
    lead: 'A concept office floor modelled the way we coordinate MEP in BIM — ductwork, VAV boxes, chilled and hot water, domestic and sanitary piping, sprinklers, cable tray and lighting, all hung from the structure in a 3 ft plenum. Trace each system, check the clash points and open the details.',
    loading: 'Federating the model…',
    cardTitle: 'Concept MEP model — one office floor',
    cardText: 'A 60 x 40 ft floor on a 20 ft grid with HVAC, hydronic, plumbing, fire protection and electrical systems at LOD 300, stacked in the ceiling plenum with their hangers and seismic bracing.',
    details: 6,
    flows: MEP_FLOWS,
    flowsLabel: 'Show flow',
    ar: { id: 'mep-model', src: '/models/ar/mep-model.glb', title: 'Concept MEP model', scale: '1:40 tabletop scale' },
    note: 'Concept model for illustration — systems, sizes and routing are typical, not a design for a specific building.',
  },
}[kind];
const entries = Object.entries(CFG.members);
---

<section class="section wf dark" data-wf data-wf-kind={kind} aria-labelledby={`wf-title-${kind}`}>
  <div class="container">
    <div class="section-head section-head--split reveal">
      <div>
        <p class="eyebrow">{CFG.eyebrow}</p>
        <h2 id={`wf-title-${kind}`}>{CFG.title}</h2>
      </div>
      <p class="lead">{CFG.lead}</p>
    </div>

    <div class="wf__layout">
      <div class="wf__stage" data-wf-stage>
        <div class="wf__loading mono" data-wf-loading>{CFG.loading}</div>
        <div class="wf__tip mono" data-wf-tip hidden></div>
        <div class="wf__pin" data-wf-pin hidden><span></span></div>
        <div class="wf__progress" aria-hidden="true"><span data-wf-bar></span></div>
        <div class="wf__controls">
          <button type="button" data-wf-replay><Icon name="RotateCcw" size={16} /> <span>Replay build</span></button>
          <button type="button" data-wf-explode aria-pressed="false"><Icon name="Layers" size={16} /> <span>Exploded view</span></button>
          <button type="button" class="wf__icon-btn" data-wf-zoom="1" aria-label="Zoom in"><Icon name="Plus" size={16} /></button>
          <button type="button" class="wf__icon-btn" data-wf-zoom="-1" aria-label="Zoom out"><Icon name="Minus" size={16} /></button>
          <ArView id={CFG.ar.id} src={CFG.ar.src} title={CFG.ar.title} scale={CFG.ar.scale} variant="overlay" />
        </div>
        <div class="wf__loads" role="group" aria-label={CFG.flowsLabel || 'Flows'} hidden={!CFG.flows.length}>
          <span class="wf__loads-label mono">{CFG.flowsLabel}</span>
          {
            CFG.flows.map((f) => (
              <button type="button" data-wf-load={f.id} aria-pressed="false" style={`--flow:${f.color}`}>
                <Icon name={f.icon} size={16} /> <span>{f.label}</span>
              </button>
            ))
          }
        </div>
        <script type="application/json" is:inline data-wf-flows set:html={JSON.stringify(CFG.flows).replace(/</g, '\\u003c')} />
        <div class="wf__lp" data-wf-lp hidden aria-live="polite">
          <p class="wf__lp-kicker mono" data-wf-lp-kicker></p>
          <h3 data-wf-lp-title></h3>
          <ol data-wf-lp-steps></ol>
          <ul class="wf__lp-key mono">
            <li><span class="wf__lp-sw" data-wf-lp-sw></span> <span data-wf-key="0">Applied load</span></li>
            <li><span class="wf__lp-dot" data-wf-lp-dot></span> <span data-wf-key="1">Load path</span></li>
            <li data-wf-key-li="2"><span class="wf__lp-sw" style="--c:#9be15d"></span> <span data-wf-key="2">Reaction</span></li>
          </ul>
        </div>
        <p class="wf__hint mono" aria-hidden="true">Scroll to zoom · drag to rotate · right-drag to pan · click any member</p>
      </div>

      <aside class="wf__panel" aria-label="Framing members">
        <div class="wf__card" data-wf-card aria-live="polite">
          <p class="wf__card-group mono">Sample model</p>
          <h3>{CFG.cardTitle}</h3>
          <p>{CFG.cardText}</p>
          <dl>
            <div><dt class="mono">Pieces</dt><dd data-wf-total>—</dd></div>
            <div><dt class="mono">Member types</dt><dd>{entries.length}</dd></div>
          </dl>
          <button type="button" class="wf__detail-btn" data-wf-open="1"><Icon name="FileText" size={16} /> Browse the {CFG.details} section details</button>
        </div>
        <div class="wf__legend">
          {
            CFG.groups.map((g) => (
              <div class="wf__group">
                <h3 class="mono">{g}</h3>
                <ul>
                  {entries
                    .filter(([, m]) => m.group === g)
                    .map(([id, m]) => (
                      <li>
                        <button type="button" data-wf-member={id} aria-pressed="false">
                          <span class="wf__sw" style={`--c:${m.color}`} />
                          {m.name}
                        </button>
                      </li>
                    ))}
                </ul>
              </div>
            ))
          }
        </div>
        <button type="button" class="wf__reset" data-wf-reset hidden><Icon name="Eye" size={16} /> Show all members</button>
      </aside>
    </div>
    <p class="wf__note mono">
      {CFG.note}
    </p>
  </div>

  <dialog class="wfd" data-wfd aria-labelledby={`wfd-title-${kind}`}>
    <div class="wfd__head">
      <div>
        <p class="wfd__kicker mono" data-wfd-kicker>Section detail</p>
        <h3 id={`wfd-title-${kind}`} data-wfd-title>Section detail</h3>
      </div>
      <button type="button" class="wfd__close" data-wfd-close aria-label="Close detail"><Icon name="X" size={20} /></button>
    </div>
    <div class="wfd__sheet" data-wfd-sheet></div>
    <div class="wfd__foot">
      <p class="wfd__member" data-wfd-member></p>
      <nav class="wfd__nav" aria-label="Section details">
        <button type="button" data-wfd-step="-1" aria-label="Previous detail"><Icon name="ChevronLeft" size={18} /></button>
        <ol data-wfd-list></ol>
        <button type="button" data-wfd-step="1" aria-label="Next detail"><Icon name="ChevronRight" size={18} /></button>
      </nav>
    </div>
  </dialog>
</section>

<style>
  .wf__layout {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 1000px) {
    .wf__layout {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 20px;
    }
  }

  .wf__stage {
    position: relative;
    height: clamp(420px, 62vw, 680px);
    overflow: hidden;
    border: 1px solid var(--line-dark);
    background:
      radial-gradient(ellipse at 50% 35%, rgba(91, 155, 230, 0.09), transparent 60%),
      var(--steel);
  }

  .wf__stage :global(.wf__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }

  .wf__stage :global(.wf__canvas:active) {
    cursor: grabbing;
  }

  .wf__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-2);
    transition: opacity 0.4s;
  }

  .wf__stage.is-ready .wf__loading {
    opacity: 0;
    pointer-events: none;
  }

  .wf__tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    padding: 6px 10px;
    background: rgba(13, 15, 19, 0.92);
    border: 1px solid var(--line-dark);
    color: var(--on-dark);
    font-size: 0.74rem;
    pointer-events: none;
    white-space: nowrap;
  }

  .wf__pin {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .wf__pin::before {
    content: '';
    position: absolute;
    left: -6px;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--blue-on-dark);
    box-shadow: 0 0 0 5px rgba(91, 155, 230, 0.28);
    animation: wf-pulse 1.8s ease-out infinite;
  }

  .wf__pin span {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 6px 10px;
    background: var(--blue);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  @keyframes wf-pulse {
    70% {
      box-shadow: 0 0 0 14px rgba(91, 155, 230, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(91, 155, 230, 0);
    }
  }

  .wf__progress {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    z-index: 2;
    background: rgba(255, 255, 255, 0.06);
  }

  .wf__progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--blue-on-dark), var(--red));
    transform: scaleX(0);
    transform-origin: left;
  }

  .wf__controls {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wf__controls button,
  .wf__reset {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-dark);
    background: rgba(13, 15, 19, 0.82);
    color: var(--on-dark);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }

  .wf__controls button:hover,
  .wf__reset:hover {
    border-color: var(--blue-on-dark);
  }

  .wf__controls button[aria-pressed='true'] {
    background: var(--blue);
    border-color: var(--blue);
  }

  .wf__controls .wf__icon-btn {
    width: 40px;
    padding: 0;
    justify-content: center;
  }

  .wf__loads[hidden] {
    display: none;
  }

  .wf__loads {
    position: absolute;
    right: 14px;
    top: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border: 1px solid var(--line-dark);
    background: rgba(13, 15, 19, 0.82);
    backdrop-filter: blur(6px);
  }

  .wf__loads-label {
    padding: 0 6px;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .wf__loads button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--on-dark);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }

  .wf__loads button:hover {
    border-color: var(--line-dark);
  }

  .wf__loads button[aria-pressed='true'] {
    background: color-mix(in srgb, var(--flow) 55%, #0d0f13);
  }

  .wf__lp {
    position: absolute;
    left: 14px;
    top: 16px;
    z-index: 2;
    width: min(330px, calc(100% - 28px));
    padding: 14px 16px;
    border: 1px solid var(--line-dark);
    border-left: 3px solid var(--lp, var(--blue-on-dark));
    background: rgba(13, 15, 19, 0.86);
    backdrop-filter: blur(6px);
    color: var(--on-dark);
  }

  .wf__lp[hidden] {
    display: none;
  }

  .wf__lp-kicker {
    margin: 0 0 4px;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lp, var(--blue-on-dark));
  }

  .wf__lp h3 {
    margin: 0 0 8px;
    font-size: 1.05rem;
  }

  .wf__lp ol {
    display: grid;
    gap: 3px;
    margin: 0 0 10px;
    padding-left: 18px;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--on-dark-2);
  }

  .wf__lp-key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0;
    padding: 8px 0 0;
    border-top: 1px solid var(--line-dark);
    list-style: none;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .wf__lp-key li[hidden] {
    display: none;
  }

  .wf__lp-key li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .wf__lp-sw {
    width: 14px;
    height: 3px;
    background: var(--c, var(--lp));
  }

  .wf__lp-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lp);
    box-shadow: 0 0 8px var(--lp);
  }

  .wf__stage.has-load .wf__hint {
    display: none;
  }

  .wf__loads:not([hidden]) ~ .wf__hint {
    top: 66px;
  }

  .wf__hint {
    position: absolute;
    right: 14px;
    top: 16px;
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--on-dark-2);
    pointer-events: none;
  }

  .wf__panel {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  @media (min-width: 1000px) {
    .wf__panel {
      max-height: clamp(420px, 62vw, 680px);
      grid-template-rows: auto minmax(0, 1fr) auto;
    }
  }

  .wf__card {
    padding: 20px;
    border: 1px solid var(--line-dark);
    border-top: 3px solid var(--blue-on-dark);
    background: var(--steel-2);
  }

  .wf__card :global(.wf__card-group) {
    margin: 0 0 6px;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-on-dark);
  }

  .wf__card :global(h3) {
    margin: 0 0 8px;
    font-size: 1.25rem;
    color: var(--on-dark);
  }

  .wf__card :global(p:not(.wf__card-group)) {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--on-dark-2);
  }

  .wf__card :global(dl) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--line-dark);
  }

  .wf__card :global(dt) {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .wf__card :global(dd) {
    margin: 4px 0 0;
    font-weight: 700;
    color: var(--on-dark);
  }

  .wf__legend {
    display: grid;
    gap: 14px;
    overflow: auto;
    padding-right: 4px;
    scrollbar-width: thin;
  }

  .wf__group h3 {
    margin: 0 0 6px;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .wf__group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wf__group button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 0 11px;
    border: 1px solid var(--line-dark);
    background: transparent;
    color: var(--on-dark);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .wf__group button:hover {
    border-color: var(--on-dark-2);
  }

  .wf__group button[aria-pressed='true'] {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  .wf__sw {
    width: 10px;
    height: 10px;
    flex: none;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  .wf__reset {
    justify-content: center;
  }

  .wf__card :global(.wf__detail-btn) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid var(--blue-on-dark);
    background: transparent;
    color: var(--on-dark);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .wf__card :global(.wf__detail-btn:hover) {
    background: var(--blue);
    border-color: var(--blue);
  }

  /* ----- section detail sheet ----- */
  .wfd {
    width: min(1180px, 96vw);
    max-width: 96vw;
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: #fbfaf6;
    color: var(--ink);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .wfd::backdrop {
    background: rgba(8, 10, 13, 0.72);
    backdrop-filter: blur(3px);
  }

  .wfd[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    animation: wfd-in 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes wfd-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.985);
    }
  }

  .wfd__head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 16px;
    padding: 16px 20px 10px;
    border-bottom: 1px solid var(--line);
  }

  .wfd__kicker {
    margin: 0 0 2px;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .wfd__head h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--ink);
  }

  .wfd__close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
  }

  .wfd__close:hover {
    border-color: var(--ink);
  }

  .wfd__sheet {
    min-height: 0;
    overflow: auto;
    padding: 10px 14px;
  }

  .wfd__sheet :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(94vh - 170px);
    margin: 0 auto;
  }

  .wfd__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 16px;
    padding: 10px 20px 14px;
    border-top: 1px solid var(--line);
  }

  .wfd__member {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-2);
  }

  .wfd__member :global(b) {
    color: var(--blue);
  }

  .wfd__nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .wfd__nav > button,
  .wfd__nav :global(ol button) {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 32px;
    padding: 0 6px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    font: 600 0.8rem var(--mono);
    cursor: pointer;
  }

  .wfd__nav ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wfd__nav :global(ol button[aria-current='true']) {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  /* drawing conventions */
  .wfd :global(.det) {
    background: #fff;
  }

  .wfd :global(.det .frame) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 1.6;
  }

  .wfd :global(.det .frame2) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.5;
  }

  .wfd :global(.det .o) {
    fill: #fff;
    stroke: #1d2025;
    stroke-width: 1.05;
    stroke-linejoin: round;
  }

  .wfd :global(.det .cut) {
    stroke-width: 1.7;
  }

  .wfd :global(.det .xh),
  .wfd :global(.det .thin) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.55;
  }

  .wfd :global(.det .stc) {
    fill: #343941;
    stroke: #1d2025;
    stroke-width: 0.8;
  }

  .wfd :global(.det .stb) {
    fill: #1d2025;
  }

  .wfd :global(.det .grout) {
    fill: #e4e0d3;
    stroke: #1d2025;
    stroke-width: 0.9;
  }

  .wfd :global(.det .deckl) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 2.2;
    stroke-linejoin: round;
  }

  .wfd :global(.det .wwf) {
    stroke: #1d2025;
    stroke-width: 0.8;
    stroke-dasharray: 2 3;
  }

  .wfd :global(.det .hl.stc),
  .wfd :global(.det .hl.stb) {
    fill: #2f76c8;
  }

  .wfd :global(.det .hl.deckl),
  .wfd :global(.det .hl.wwf) {
    fill: none;
    stroke: #2f76c8;
  }

  .wfd :global(.det .duct) {
    fill: #eaf3fc;
    stroke: #1d2025;
    stroke-width: 1.3;
  }

  .wfd :global(.det .liner) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.5;
    stroke-dasharray: 3 2;
  }

  .wfd :global(.det .flexd) {
    fill: #f1f4f7;
    stroke: #1d2025;
    stroke-width: 1;
  }

  .wfd :global(.det .ceil) {
    stroke: #1d2025;
    stroke-width: 2.4;
  }

  .wfd :global(.det .rod) {
    stroke: #1d2025;
    stroke-width: 1.2;
  }

  .wfd :global(.det .ins) {
    fill: #f6eedd;
    stroke: #1d2025;
    stroke-width: 0.8;
    stroke-dasharray: 2 1.5;
  }

  .wfd :global(.det .pipe) {
    fill: #cfd6dc;
    stroke: #1d2025;
    stroke-width: 1.2;
  }

  .wfd :global(.det .pipeR) {
    fill: #f3c4bf;
    stroke: #1d2025;
    stroke-width: 1;
  }

  .wfd :global(.det .pipeh),
  .wfd :global(.det .thick) {
    stroke: #1d2025;
    stroke-width: 2.4;
  }

  .wfd :global(.det .clash) {
    fill: rgba(255, 45, 85, 0.08);
    stroke: #e5193f;
    stroke-width: 1.6;
    stroke-dasharray: 5 3;
  }

  .wfd :global(.det .hanger),
  .wfd :global(.det .hangerC) {
    fill: none;
    stroke: #4a5058;
    stroke-width: 2;
  }

  .wfd :global(.det .cable) {
    fill: #3a3f46;
    stroke: #1d2025;
    stroke-width: 0.4;
  }

  .wfd :global(.det .whip) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 2;
    stroke-dasharray: 6 2;
  }

  .wfd :global(.det .wire) {
    stroke: #1d2025;
    stroke-width: 0.6;
    stroke-dasharray: 4 3;
  }

  .wfd :global(.det .hl.hanger),
  .wfd :global(.det .hl.hangerC),
  .wfd :global(.det .hl.whip) {
    fill: none;
    stroke: #2f76c8;
  }

  .wfd :global(.det .ply) {
    fill: url(#d-ply);
    stroke: #1d2025;
    stroke-width: 0.9;
  }

  .wfd :global(.det .st) {
    fill: #7f8892;
    stroke: #1d2025;
    stroke-width: 0.9;
  }

  .wfd :global(.det .st2) {
    fill: rgba(127, 136, 146, 0.5);
    stroke: #1d2025;
    stroke-width: 0.9;
  }

  .wfd :global(.det .stl) {
    fill: none;
    stroke: #59616a;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wfd :global(.det .hid) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.8;
    stroke-dasharray: 6 3;
  }

  .wfd :global(.det .conc) {
    fill: url(#d-conc);
    stroke: #1d2025;
    stroke-width: 1.5;
  }

  .wfd :global(.det .earth) {
    fill: url(#d-earth);
  }

  .wfd :global(.det .grade) {
    stroke: #1d2025;
    stroke-width: 1.8;
  }

  .wfd :global(.det .roof) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 2.2;
  }

  .wfd :global(.det .brk) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.8;
  }

  .wfd :global(.det .ld) {
    fill: none;
    stroke: #1d2025;
    stroke-width: 0.7;
  }

  .wfd :global(.det .dot) {
    fill: #1d2025;
  }

  .wfd :global(.det .tx) {
    font: 500 10.5px 'IBM Plex Mono', ui-monospace, monospace;
    fill: #1d2025;
    letter-spacing: 0.02em;
  }

  .wfd :global(.det .bg) {
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 5px;
  }

  .wfd :global(.det .nail) {
    font: 700 16px sans-serif;
    fill: #1d2025;
  }

  .wfd :global(.det .dim line) {
    stroke: #1d2025;
    stroke-width: 0.6;
  }

  .wfd :global(.det .dim .tk) {
    stroke-width: 1.3;
  }

  .wfd :global(.det .bub) {
    fill: #fff;
    stroke: #1d2025;
    stroke-width: 1.5;
  }

  .wfd :global(.det .bubl) {
    stroke: #1d2025;
    stroke-width: 1;
  }

  .wfd :global(.det .bubn) {
    font: 700 15px 'IBM Plex Mono', ui-monospace, monospace;
    fill: #1d2025;
  }

  .wfd :global(.det .bubs) {
    font: 500 9px 'IBM Plex Mono', ui-monospace, monospace;
    fill: #1d2025;
  }

  .wfd :global(.det .ttl) {
    font: 700 15px 'IBM Plex Mono', ui-monospace, monospace;
    fill: #1d2025;
    letter-spacing: 0.03em;
  }

  .wfd :global(.det .ttll) {
    stroke: #1d2025;
    stroke-width: 1.4;
  }

  /* selected member, highlighted in the drawing */
  .wfd :global(.det .hl:not(.note):not(g)),
  .wfd :global(.det g.hl:not(.note) polygon) {
    fill: #d5e5f7;
    stroke: #004e92;
    stroke-width: 2;
  }

  .wfd :global(.det .hl.st),
  .wfd :global(.det .hl.st2) {
    fill: #2f76c8;
  }

  .wfd :global(.det .hl.stl) {
    fill: none;
    stroke: #2f76c8;
  }

  .wfd :global(.det .hl.hid),
  .wfd :global(.det .hl.thin) {
    fill: none;
  }

  .wfd :global(.det .hl.ply) {
    fill: #9cc2ea;
  }

  .wfd :global(.det .note.hl .tx) {
    fill: #004e92;
    font-weight: 700;
  }

  .wfd :global(.det .note.hl .ld) {
    stroke: #004e92;
    stroke-width: 1.2;
  }

  .wfd :global(.det .note.hl .dot) {
    fill: #004e92;
  }

  @media (max-width: 640px) {
    .wfd {
      width: 100vw;
      max-width: 100vw;
      max-height: 100dvh;
      height: 100dvh;
    }

    .wfd__sheet :global(svg) {
      width: 900px;
      max-width: none;
      max-height: none;
    }
  }


  .wf__note {
    margin: 14px 0 0;
    font-size: 0.7rem;
    color: var(--on-dark-2);
  }

  @media (max-width: 999px) {
    .wf__loads {
      top: auto;
      left: 14px;
      right: auto;
      bottom: 64px;
    }
  }

  @media (max-width: 640px) {
    .wf__controls button span,
    .wf__loads button span {
      display: none;
    }

    .wf__lp ol {
      display: none;
    }

    .wf__controls button {
      width: 40px;
      padding: 0;
      justify-content: center;
    }

    .wf__hint {
      display: none;
    }
  }
</style>

<script>
  import { MEMBERS, type Member } from '../data/woodFrame';
  import { STEEL_MEMBERS } from '../data/steelFrame';
  import { MEP_MEMBERS } from '../data/mepModel';
  import { getMepDetails } from '../scripts/mepDetails';
  import { getDetails } from '../scripts/frameDetails';
  import { getSteelDetails } from '../scripts/steelDetails';
  type MemberId = string;

  document.querySelectorAll<HTMLElement>('[data-wf]').forEach((section) => {
    const kind = section.dataset.wfKind ?? 'wood';
    const CAT: Record<string, Member> = kind === 'steel' ? STEEL_MEMBERS : kind === 'mep' ? MEP_MEMBERS : MEMBERS;
    const stage = section.querySelector<HTMLElement>('[data-wf-stage]')!;
    const card = section.querySelector<HTMLElement>('[data-wf-card]')!;
    const defaultCard = card.innerHTML;
    const buttons = [...section.querySelectorAll<HTMLButtonElement>('[data-wf-member]')];
    const reset = section.querySelector<HTMLButtonElement>('[data-wf-reset]')!;
    const loadBtns = [...section.querySelectorAll<HTMLButtonElement>('[data-wf-load]')];
    const lp = section.querySelector<HTMLElement>('[data-wf-lp]')!;
    type Flow = { id: string; color: string; kicker: string; title: string; steps: string[]; key?: [string, string, string] };
    const LOADS: Record<string, Flow> = Object.fromEntries(
      (JSON.parse(section.querySelector('[data-wf-flows]')?.textContent || '[]') as Flow[]).map((f) => [f.id, f]),
    );
    const showLoad = (mode: string | null) => {
      loadBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.wfLoad === mode)));
      stage.classList.toggle('has-load', !!mode);
      lp.hidden = !mode;
      if (!mode) return;
      const d = LOADS[mode];
      lp.style.setProperty('--lp', d.color);
      lp.querySelector('[data-wf-lp-kicker]')!.textContent = d.kicker;
      lp.querySelector('[data-wf-lp-title]')!.textContent = d.title;
      lp.querySelector('[data-wf-lp-steps]')!.innerHTML = d.steps.map((t) => `<li>${t}</li>`).join('');
      const key = d.key ?? ['Applied load', 'Load path', 'Reaction'];
      key.forEach((k, i) => (lp.querySelector(`[data-wf-key="${i}"]`)!.textContent = k));
      lp.querySelector<HTMLElement>('[data-wf-key-li="2"]')!.hidden = mode === 'fire' || mode === 'power' || mode === 'water';
      explodeBtn.setAttribute('aria-pressed', 'false');
    };
    loadBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const mode = b.dataset.wfLoad!;
        api?.setLoad(b.getAttribute('aria-pressed') === 'true' ? null : mode);
      }),
    );
    const explodeBtn = section.querySelector<HTMLButtonElement>('[data-wf-explode]')!;
    const bar = section.querySelector<HTMLElement>('[data-wf-bar]')!;
    let api: import('../scripts/woodFrame').FrameApi | null = null;

    // ----- section detail sheet -----
    const dlg = section.querySelector<HTMLDialogElement>('[data-wfd]')!;
    const sheet = dlg.querySelector<HTMLElement>('[data-wfd-sheet]')!;
    const list = dlg.querySelector<HTMLOListElement>('[data-wfd-list]')!;
    const details = kind === 'steel' ? getSteelDetails() : kind === 'mep' ? getMepDetails() : getDetails();
    let current = 1;
    let focusMember: MemberId | null = null;
    list.innerHTML = details.map((d) => `<li><button type="button" data-wfd-go="${d.no}" title="${d.title}">${d.no}</button></li>`).join('');
    const renderDetail = (no: number) => {
      const d = details.find((x) => x.no === no) ?? details[0];
      current = d.no;
      sheet.innerHTML = d.svg;
      dlg.querySelector('[data-wfd-kicker]')!.textContent = `Sheet ${d.sheet ?? 'S-501'} · Detail ${d.no} of ${details.length}`;
      dlg.querySelector('[data-wfd-title]')!.textContent = d.title;
      list.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-current', String(Number(b.dataset.wfdGo) === d.no)));
      const m = focusMember && d.members.includes(focusMember) ? focusMember : null;
      if (m) sheet.querySelectorAll(`[data-m~="${m}"]`).forEach((el) => el.classList.add('hl'));
      const shown = d.members.filter((id) => id in CAT).map((id) => CAT[id as MemberId].name);
      dlg.querySelector('[data-wfd-member]')!.innerHTML = m
        ? `Highlighted: <b>${esc(CAT[m].name)}</b> — ${esc(CAT[m].size)}`
        : `Shows: ${esc(shown.slice(0, 6).join(', '))}${shown.length > 6 ? '…' : ''}`;
    };
    const openDetail = (no: number, m: MemberId | null) => {
      focusMember = m;
      renderDetail(no);
      if (!dlg.open) dlg.showModal();
    };
    dlg.querySelector('[data-wfd-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.querySelectorAll<HTMLButtonElement>('[data-wfd-step]').forEach((b) =>
      b.addEventListener('click', () => renderDetail(((current - 1 + Number(b.dataset.wfdStep) + details.length) % details.length) + 1)),
    );
    list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-wfd-go]');
      if (b) renderDetail(Number(b.dataset.wfdGo));
    });
    card.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-wf-open]');
      if (b) openDetail(Number(b.dataset.wfOpen), (b.dataset.wfMember as MemberId) || null);
    });

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const show = (c: MemberId | null) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.wfMember === c)));
      reset.hidden = c === null;
      if (!c) {
        card.innerHTML = defaultCard;
        const total = card.querySelector('[data-wf-total]');
        if (total && api) total.textContent = api.total.toLocaleString();
        return;
      }
      const m = CAT[c];
      const n = api?.counts[c] ?? 0;
      card.innerHTML = `<p class="wf__card-group mono">${esc(m.group)}</p><h3>${esc(m.name)}</h3><p>${esc(m.role)}</p><dl><div><dt class="mono">Typical size</dt><dd>${esc(m.size)}</dd></div><div><dt class="mono">In this model</dt><dd>${n.toLocaleString()} ${n === 1 ? 'piece' : 'pieces'}</dd></div></dl><button type="button" class="wf__detail-btn" data-wf-open="${m.detail}" data-wf-member="${c}">View section detail ${m.detail}</button>`;
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const c = b.dataset.wfMember as MemberId;
        api?.select(b.getAttribute('aria-pressed') === 'true' ? null : c);
      }),
    );
    reset.addEventListener('click', () => api?.select(null));
    explodeBtn.addEventListener('click', () => {
      const on = explodeBtn.getAttribute('aria-pressed') !== 'true';
      explodeBtn.setAttribute('aria-pressed', String(on));
      api?.setExplode(on);
    });
    section.querySelector('[data-wf-replay]')!.addEventListener('click', () => api?.replay());
    section.querySelectorAll<HTMLButtonElement>('[data-wf-zoom]').forEach((b) => b.addEventListener('click', () => api?.zoom(Number(b.dataset.wfZoom) as 1 | -1)));

    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries[0].isIntersecting || api) return;
        io.disconnect();
        try {
          const mount =
            kind === 'steel'
              ? (await import('../scripts/steelFrame')).mountSteelFrame
              : kind === 'mep'
                ? (await import('../scripts/mepFrame')).mountMepFrame
                : (await import('../scripts/woodFrame')).mountWoodFrame;
          api = mount(stage, {
            tip: section.querySelector<HTMLElement>('[data-wf-tip]')!,
            pin: section.querySelector<HTMLElement>('[data-wf-pin]')!,
            onSelect: (c) => {
              show(c);
              if (c) openDetail(CAT[c].detail, c);
            },
            onProgress: (p) => (bar.style.transform = `scaleX(${p})`),
            onLoad: showLoad,
          });
          stage.classList.add('is-ready');
          show(null);
        } catch (err) {
          console.error(err);
          section.querySelector('[data-wf-loading]')!.textContent = '3D view unavailable on this device';
        }
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(section);
  });
</script>
