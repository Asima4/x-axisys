  }

  @media (max-width: 640px) {
    .wfd {
      width: 100vw;
      max-width: 100vw;
      max-height: 100dvh;
      height: 100dvh;
    }

    .wfd__sheet :global(svg) {
      width: 900px;
      max-width: none;
      max-height: none;
    }
  }


  .wf__note {
    margin: 14px 0 0;
    font-size: 0.7rem;
    color: var(--on-dark-2);
  }

  @media (max-width: 999px) {
    .wf__loads {
      top: auto;
      left: 14px;
      right: auto;
      bottom: 64px;
    }
  }

  @media (max-width: 640px) {
    .wf__controls button span,
    .wf__loads button span {
      display: none;
    }

    .wf__lp ol {
      display: none;
    }

    .wf__controls button {
      width: 40px;
      padding: 0;
      justify-content: center;
    }

    .wf__hint {
      display: none;
    }
  }
</style>

<script>
  import { MEMBERS, type Member } from '../data/woodFrame';
  import { STEEL_MEMBERS } from '../data/steelFrame';
  import { getDetails } from '../scripts/frameDetails';
  import { getSteelDetails } from '../scripts/steelDetails';
  type MemberId = string;

  document.querySelectorAll<HTMLElement>('[data-wf]').forEach((section) => {
    const steel = section.dataset.wfKind === 'steel';
    const CAT: Record<string, Member> = steel ? STEEL_MEMBERS : MEMBERS;
    const stage = section.querySelector<HTMLElement>('[data-wf-stage]')!;
    const card = section.querySelector<HTMLElement>('[data-wf-card]')!;
    const defaultCard = card.innerHTML;
    const buttons = [...section.querySelectorAll<HTMLButtonElement>('[data-wf-member]')];
    const reset = section.querySelector<HTMLButtonElement>('[data-wf-reset]')!;
    const loadBtns = [...section.querySelectorAll<HTMLButtonElement>('[data-wf-load]')];
    const lp = section.querySelector<HTMLElement>('[data-wf-lp]')!;
    const LOADS = {
      gravity: {
        color: '#5b9be6',
        kicker: 'Load path · Gravity',
        title: 'Roof and floor loads down to the soil',
        steps: [
          'Roof dead + snow load on the rafters and garage trusses',
          'Rafters bear on the top plate (H2.5A ties) and the ridge (LSSU210)',
          'Floor joists carry the second floor to the rim and centre bearing wall',
          'Studs, king studs and trimmers take it down both storeys',
          'Sill plate → slab and thickened footing → soil',
        ],
      },
      wind: {
        color: '#35d0c0',
        kicker: 'Load path · Wind',
        title: 'Lateral pressure and roof uplift',
        steps: [
          'Wind pressure on the wall is collected by the floor and roof diaphragms',
          'LTP4 ties and A35 clips pass the shear into the wall top plates',
          'Sheathed shear walls carry it to the foundation',
          'HDU5 hold-downs and MSTC48B3 straps resist overturning',
          'Roof uplift is tied down by H2.5A ties and LSTA21 ridge straps',
        ],
      },
      seismic: {
        color: '#ff6a45',
        kicker: 'Load path · Seismic',
        title: 'Inertial forces from the building’s own mass',
        steps: [
          'Ground shaking makes the mass sway — forces grow with height',
          'Roof and floor diaphragms deliver the storey forces to the shear walls',
          'Shear walls carry them down, MSTC48B3 straps across the floor',
          'HDU5 hold-downs anchor the wall ends against overturning',
          'Anchor bolts deliver base shear into the foundation',
        ],
      },
    } as const;
    const showLoad = (mode: keyof typeof LOADS | null) => {
      loadBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.wfLoad === mode)));
      stage.classList.toggle('has-load', !!mode);
      lp.hidden = !mode;
      if (!mode) return;
      const d = LOADS[mode];
      lp.style.setProperty('--lp', d.color);
      lp.querySelector('[data-wf-lp-kicker]')!.textContent = d.kicker;
      lp.querySelector('[data-wf-lp-title]')!.textContent = d.title;
      lp.querySelector('[data-wf-lp-steps]')!.innerHTML = d.steps.map((t) => `<li>${t}</li>`).join('');
      explodeBtn.setAttribute('aria-pressed', 'false');
    };
    loadBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const mode = b.dataset.wfLoad as keyof typeof LOADS;
        api?.setLoad(b.getAttribute('aria-pressed') === 'true' ? null : mode);
      }),
    );
    const explodeBtn = section.querySelector<HTMLButtonElement>('[data-wf-explode]')!;
    const bar = section.querySelector<HTMLElement>('[data-wf-bar]')!;
    let api: import('../scripts/woodFrame').FrameApi | null = null;

    // ----- section detail sheet -----
    const dlg = section.querySelector<HTMLDialogElement>('[data-wfd]')!;
    const sheet = dlg.querySelector<HTMLElement>('[data-wfd-sheet]')!;
    const list = dlg.querySelector<HTMLOListElement>('[data-wfd-list]')!;
    const details = steel ? getSteelDetails() : getDetails();
    let current = 1;
    let focusMember: MemberId | null = null;
    list.innerHTML = details.map((d) => `<li><button type="button" data-wfd-go="${d.no}" title="${d.title}">${d.no}</button></li>`).join('');
    const renderDetail = (no: number) => {
      const d = details.find((x) => x.no === no) ?? details[0];
      current = d.no;
      sheet.innerHTML = d.svg;
      dlg.querySelector('[data-wfd-kicker]')!.textContent = `Sheet ${d.sheet ?? 'S-501'} · Detail ${d.no} of ${details.length}`;
      dlg.querySelector('[data-wfd-title]')!.textContent = d.title;
      list.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-current', String(Number(b.dataset.wfdGo) === d.no)));
      const m = focusMember && d.members.includes(focusMember) ? focusMember : null;
      if (m) sheet.querySelectorAll(`[data-m~="${m}"]`).forEach((el) => el.classList.add('hl'));
      const shown = d.members.filter((id) => id in CAT).map((id) => CAT[id as MemberId].name);
      dlg.querySelector('[data-wfd-member]')!.innerHTML = m
        ? `Highlighted: <b>${esc(CAT[m].name)}</b> — ${esc(CAT[m].size)}`
        : `Shows: ${esc(shown.slice(0, 6).join(', '))}${shown.length > 6 ? '…' : ''}`;
    };
    const openDetail = (no: number, m: MemberId | null) => {
      focusMember = m;
      renderDetail(no);
      if (!dlg.open) dlg.showModal();
    };
    dlg.querySelector('[data-wfd-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.querySelectorAll<HTMLButtonElement>('[data-wfd-step]').forEach((b) =>
      b.addEventListener('click', () => renderDetail(((current - 1 + Number(b.dataset.wfdStep) + details.length) % details.length) + 1)),
    );
    list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-wfd-go]');
      if (b) renderDetail(Number(b.dataset.wfdGo));
    });
    card.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-wf-open]');
      if (b) openDetail(Number(b.dataset.wfOpen), (b.dataset.wfMember as MemberId) || null);
    });

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const show = (c: MemberId | null) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.wfMember === c)));
      reset.hidden = c === null;
      if (!c) {
        card.innerHTML = defaultCard;
        const total = card.querySelector('[data-wf-total]');
        if (total && api) total.textContent = api.total.toLocaleString();
        return;
      }
      const m = CAT[c];
      const n = api?.counts[c] ?? 0;
      card.innerHTML = `<p class="wf__card-group mono">${esc(m.group)}</p><h3>${esc(m.name)}</h3><p>${esc(m.role)}</p><dl><div><dt class="mono">Typical size</dt><dd>${esc(m.size)}</dd></div><div><dt class="mono">In this model</dt><dd>${n.toLocaleString()} ${n === 1 ? 'piece' : 'pieces'}</dd></div></dl><button type="button" class="wf__detail-btn" data-wf-open="${m.detail}" data-wf-member="${c}">View section detail ${m.detail}</button>`;
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const c = b.dataset.wfMember as MemberId;
        api?.select(b.getAttribute('aria-pressed') === 'true' ? null : c);
      }),
    );
    reset.addEventListener('click', () => api?.select(null));
    explodeBtn.addEventListener('click', () => {
      const on = explodeBtn.getAttribute('aria-pressed') !== 'true';
      explodeBtn.setAttribute('aria-pressed', String(on));
      api?.setExplode(on);
    });
    section.querySelector('[data-wf-replay]')!.addEventListener('click', () => api?.replay());
    section.querySelectorAll<HTMLButtonElement>('[data-wf-zoom]').forEach((b) => b.addEventListener('click', () => api?.zoom(Number(b.dataset.wfZoom) as 1 | -1)));

    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries[0].isIntersecting || api) return;
        io.disconnect();
        try {
          const mount = steel ? (await import('../scripts/steelFrame')).mountSteelFrame : (await import('../scripts/woodFrame')).mountWoodFrame;
          api = mount(stage, {
            tip: section.querySelector<HTMLElement>('[data-wf-tip]')!,
            pin: section.querySelector<HTMLElement>('[data-wf-pin]')!,
            onSelect: (c) => {
              show(c);
              if (c) openDetail(CAT[c].detail, c);
            },
            onProgress: (p) => (bar.style.transform = `scaleX(${p})`),
            onLoad: showLoad,
          });
          stage.classList.add('is-ready');
          show(null);
        } catch (err) {
          console.error(err);
          section.querySelector('[data-wf-loading]')!.textContent = '3D view unavailable on this device';
        }
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(section);
  });
</script>
