---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  sector: string;
  summary: string;
  disciplines: string[];
  image?: ImageMetadata;
  meta?: string;
  badge?: string;
  featured?: boolean;
}

const { href, title, sector, summary, disciplines, image, meta, badge, featured = false } = Astro.props;
const labels: Record<string, string> = {
  arch: 'Architecture',
  str: 'Structure',
  mep: 'MEP',
  bim: 'BIM',
  render: 'Visualisation',
  scan: 'Laser scanning',
};
---

<article class:list={['project-card reveal', { 'project-card--featured': featured }]} data-disciplines={disciplines.join(' ')}>
  <a href={href} class="project-card__link">
    <div class="project-card__media">
      {
        image ? (
          <Image src={image} alt="" widths={[600, 900, 1400]} sizes={featured ? '(min-width: 1000px) 60vw, 100vw' : '(min-width: 1000px) 33vw, 100vw'} />
        ) : (
          <div class="project-card__placeholder">
            <Icon name="Building2" size={40} />
          </div>
        )
      }
      {badge && <span class="project-card__badge mono">{badge}</span>}
    </div>
    <div class="project-card__body">
      <p class="project-card__meta mono">{[sector, meta].filter(Boolean).join(' · ')}</p>
      <h3>{title}</h3>
      <p class="project-card__summary">{summary}</p>
      <ul class="project-card__chips">
        {disciplines.map((d) => <li>{labels[d] ?? d}</li>)}
      </ul>
      <span class="text-link">
        View project <Icon name="ArrowRight" />
      </span>
    </div>
  </a>
</article>

<style>
  .project-card__link {
    display: grid;
    height: 100%;
    background: var(--white);
    border: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card__link:hover {
    border-color: #bdb9ae;
    box-shadow: 0 24px 48px -28px rgba(20, 22, 26, 0.35);
  }

  @media (min-width: 900px) {
    .project-card--featured .project-card__link {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
    background: var(--steel);
  }

  .project-card__media img,
  .project-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project-card__link:hover .project-card__media img {
    transform: scale(1.04);
  }

  .project-card__placeholder {
    display: grid;
    place-items: center;
    color: var(--on-dark-2);
  }

  .project-card__badge {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 5px 10px;
    border-radius: 2px;
    background: rgba(13, 15, 19, 0.85);
    color: var(--on-dark);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card__body {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: clamp(22px, 3vw, 36px);
  }

  .project-card--featured .project-card__body {
    align-content: center;
  }

  .project-card__meta {
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .project-card h3 {
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
  }

  .project-card--featured h3 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }

  .project-card__summary {
    font-size: 0.98rem;
  }

  .project-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 4px 0 8px;
    padding: 0;
  }

  .project-card__chips li {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--blue-soft);
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 600;
  }
</style>
