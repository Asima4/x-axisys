---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ApplyForm from '../components/ApplyForm.astro';
import Icon from '../components/Icon.astro';

const perks = [
  { icon: 'Laptop', title: 'Flexible, remote-friendly', text: 'Work with a distributed team using modern cloud collaboration tools.' },
  { icon: 'Cpu', title: 'Work with new technology', text: 'BIM, automation, reality capture and AI tools are part of everyday work.' },
  { icon: 'Building2', title: 'Real, varied projects', text: 'Residential, commercial and industrial work across multiple disciplines.' },
  { icon: 'GraduationCap', title: 'Room to grow', text: 'Learn from colleagues in other disciplines and take on more responsibility.' },
];

const roles = [
  {
    title: 'BIM Modeler — Architectural',
    text: 'Develop detailed architectural BIM models and resolve coordination issues with architects and engineers.',
    skills: ['Revit', 'Navisworks', 'Construction documentation'],
  },
  {
    title: 'MEP Design Engineer',
    text: 'Design and analyse mechanical, electrical and plumbing systems with a focus on code compliance and efficiency.',
    skills: ['HVAC & electrical design', 'AutoCAD', 'Revit MEP'],
  },
  {
    title: 'Structural Design Engineer',
    text: 'Analyse and design structural systems and prepare calculations and drawings for review.',
    skills: ['ETABS / SAP2000', 'RC & steel design', 'Detailing'],
  },
  {
    title: 'Visualisation & Digital Specialist',
    text: 'Create renders, animations and immersive experiences from design models.',
    skills: ['Lumion / Enscape', 'Unreal / Unity', '3ds Max'],
  },
];

const roleNames = roles.map((r) => r.title);
---

<Base
  title="Careers"
  description="Join Axisys Global Engineering — work on multidisciplinary engineering projects with BIM, automation and AI. See the roles we hire for and apply online."
>
  <PageHero
    eyebrow="Careers"
    title="Build the future of engineering with us."
    lead="Join engineers, designers and technologists who combine deep technical skill with new ways of working."
  >
    <div class="btn-row">
      <a class="btn" href="#apply">Apply now <Icon name="ArrowRight" /></a>
      <a class="btn btn--outline" href="#roles">Roles we hire for</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Why Axisys</p>
        <h2>Serious engineering. Modern tools. Real growth.</h2>
      </div>
      <ul class="perks">
        {
          perks.map((p, i) => (
            <li class="reveal" style={`transition-delay:${i * 60}ms`}>
              <Icon name={p.icon} size={26} />
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--white rule-top" id="roles">
    <div class="container">
      <div class="section-head section-head--split reveal">
        <div>
          <p class="eyebrow">Roles</p>
          <h2>Roles we regularly hire for.</h2>
        </div>
        <p class="lead">Don’t see your exact role? Send a general application — we’re always glad to hear from talented people.</p>
      </div>
      <ul class="roles">
        {
          roles.map((r) => (
            <li class="reveal">
              <div>
                <h3>{r.title}</h3>
                <p>{r.text}</p>
              </div>
              <ul class="tags">
                {r.skills.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tint rule-top" id="apply">
    <div class="container apply">
      <div class="apply__intro reveal">
        <p class="eyebrow">Apply</p>
        <h2>Send your application.</h2>
        <p class="lead">Tell us about yourself and attach your CV. We review every application personally.</p>
      </div>
      <div class="apply__card reveal">
        <ApplyForm roles={roleNames} />
      </div>
    </div>
  </section>
</Base>

<style>
  .perks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .perks li {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 32px 28px;
    background: var(--paper);
  }

  .perks li :global(svg) {
    color: var(--blue);
    margin-bottom: 6px;
  }

  .perks h3 {
    font-size: 1.15rem;
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .roles > li {
    display: grid;
    gap: 16px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 860px) {
    .roles > li {
      grid-template-columns: 1.4fr 1fr;
      gap: 48px;
      align-items: center;
    }

    .roles .tags {
      justify-content: flex-end;
    }
  }

  .roles h3 {
    margin-bottom: 8px;
  }

  .apply {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 1000px) {
    .apply {
      grid-template-columns: 0.7fr 1.3fr;
      gap: 72px;
      align-items: start;
    }

    .apply__intro {
      position: sticky;
      top: 120px;
    }
  }

  .apply__intro {
    display: grid;
    gap: 18px;
  }

  .apply__card {
    padding: clamp(24px, 4vw, 48px);
    background: var(--white);
    border: 1px solid var(--line);
  }
</style>
